# ---------------------------------------------------------------------------
# Nginx module (PR 3)
#
# Installs nginx from apt and manages HTTP reverse-proxy sites, one file per
# domain: /etc/nginx/conf.d/<domain>.conf. ezvps does not create or manage
# anything in sites-available/sites-enabled; those directories are only read to
# migrate sites an older ezvps put there (marked "# Managed by ezvps") and to
# offer disabling Debian's default site. HTTP ONLY: certificates and HTTPS
# belong to the separate Certificates module (later PR); nothing here issues,
# stores or references a certificate.
#
# Rule used everywhere: `nginx -t` must pass before nginx is reloaded or
# restarted. A change whose test fails is rolled back and nginx is left alone.
# ---------------------------------------------------------------------------

NGX_SERVICE_NAME="nginx"
NGX_DIR="${EZVPS_NGINX_DIR:-/etc/nginx}"
NGX_CONFD="${NGX_DIR}/conf.d"
NGX_CONF="${NGX_DIR}/nginx.conf"
# Legacy layout: read only for the migration and the Debian default site.
NGX_AVAIL="${NGX_DIR}/sites-available"
NGX_ENABLED="${NGX_DIR}/sites-enabled"
NGX_HTTP_PORT="${EZVPS_NGINX_HTTP_PORT:-80}"
NGX_BACKUP_BASE="${EZVPS_BACKUP_DIR:-/var/backups/ezvps}"

# Filled by ngx_config_test / ngx_probe / ngx_read_site / ngx_parse_upstream / backup_file.
NGX_TEST_OUT=""
NGX_PROBE_CODE=""
NGX_SITE_DOMAIN="" NGX_SITE_UPSTREAM="" NGX_SITE_MANAGED=0
NGX_UP=""
BACKUP_FILE_PATH=""
NGX_SERVER_NAME_RE='^[[:space:]]*server_name[[:space:]]+([^;]+);'

# Installed = the nginx command exists, or dpkg says the package is installed.
ngx_installed() {
    have_cmd nginx && return 0
    if have_cmd dpkg-query; then
        # shellcheck disable=SC2016 # ${db:...} is a dpkg-query format, not a shell expansion
        [[ "$(dpkg-query -W -f='${db:Status-Abbrev}' nginx 2>/dev/null)" == ii* ]] && return 0
    fi
    return 1
}

ngx_need_nginx() {
    if ! ngx_installed; then
        info "Nginx is not installed. Choose 'Install Nginx' first."
        return 1
    fi
    if ! have_cmd nginx; then
        err "The nginx package is installed but the 'nginx' command is not in PATH (is /usr/sbin in PATH?)."
        return 1
    fi
    return 0
}

ngx_version() {
    local v
    have_cmd nginx || return 0
    v="$(nginx -v 2>&1)"
    v="${v#*nginx version: }"
    printf '%s' "${v//[[:cntrl:]]/}"
}

ngx_service_state() {
    have_cmd systemctl || {
        printf 'unknown'
        return 0
    }
    if systemctl is-active --quiet "$NGX_SERVICE_NAME" 2>/dev/null; then
        printf 'running'
    else
        printf 'not running'
    fi
}

# nginx -t. Output kept in NGX_TEST_OUT; return 0 only when the config is valid.
ngx_config_test() {
    NGX_TEST_OUT="$(nginx -t 2>&1)"
    return $?
}

ngx_print_test_output() {
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && err "  ${line}"
    done <<<"$NGX_TEST_OUT"
    return 0
}

# Does nginx answer an HTTP request on 127.0.0.1:<port>? Pure bash (/dev/tcp),
# so it also works on a fresh image without curl. Sets NGX_PROBE_CODE.
ngx_probe() {
    local line
    NGX_PROBE_CODE=""
    line="$(
        (
            resp=""
            exec 3<>"/dev/tcp/127.0.0.1/${NGX_HTTP_PORT}" || exit 1
            printf 'HEAD / HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
            read -r -t 5 resp <&3 || true
            printf '%s' "$resp"
        ) 2>/dev/null
    )"
    if [[ "$line" =~ ^HTTP/[0-9.]+[[:space:]]+([1-5][0-9][0-9]) ]]; then
        NGX_PROBE_CODE="${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

ngx_wait_ready() {
    local waited=0 max="${EZVPS_NGINX_WAIT_SECONDS:-15}"
    while true; do
        ngx_probe && return 0
        ((waited >= max)) && return 1
        sleep_s 1
        waited=$((waited + 1))
    done
}

ngx_verify_response() {
    if ngx_wait_ready; then
        info "Verified: nginx answers on 127.0.0.1:${NGX_HTTP_PORT} (HTTP ${NGX_PROBE_CODE})."
        return 0
    fi
    err "nginx did not answer on 127.0.0.1:${NGX_HTTP_PORT}."
    err "Check: systemctl status ${NGX_SERVICE_NAME}   and   journalctl -u ${NGX_SERVICE_NAME} -n 50"
    return 1
}

# Reload only when the service is running (a reload of a stopped unit fails).
# Callers must have a passing config test first.
ngx_reload() {
    if [[ "$(ngx_service_state)" != "running" ]]; then
        info "nginx is not running, so nothing was reloaded. The config is valid; use Restart to start it."
        return 0
    fi
    if systemctl reload "$NGX_SERVICE_NAME"; then
        info "nginx reloaded."
    else
        err "systemctl reload ${NGX_SERVICE_NAME} failed. Check: journalctl -u ${NGX_SERVICE_NAME} -n 50"
    fi
    return 0
}

# --- generic backup of one file ----------------------------------------------

# backup_file <src> <label>: copy to /var/backups/ezvps/<label>.<timestamp>.<pid>
# (dir mode 700). Sets BACKUP_FILE_PATH. Non-zero (and a message) on failure.
backup_file() {
    local dest
    BACKUP_FILE_PATH=""
    dest="${NGX_BACKUP_BASE}/${2}.$(date +%Y%m%d-%H%M%S).$$"
    if ! { mkdir -p "$NGX_BACKUP_BASE" && chmod 700 "$NGX_BACKUP_BASE" && cp -a "$1" "$dest"; }; then
        err "Backup of ${1} to ${dest} failed; aborting before any change."
        return 1
    fi
    BACKUP_FILE_PATH="$dest"
    info "Backed up ${1} to ${dest}"
    return 0
}

# --- nginx.org stable source ----------------------------------------------------------------
# nginx is installed ONLY from the official nginx.org stable repository (never
# the distribution's package, never the mainline branch). The repository, its
# signing key and an apt pin (origin nginx.org, priority 900) are set up first,
# so apt can not fall back to the distribution's newer-looking or higher-ranked
# package later.
#
# Debian and Ubuntu use the same layout and package names on nginx.org; only the
# repository path differs. ngx_select_repo picks NGX_ORG_REPO_URL from the
# detected distro, and the codename (trixie / noble) comes from os-release.

NGX_ORG_REPO_DEBIAN="https://nginx.org/packages/debian"
NGX_ORG_REPO_UBUNTU="https://nginx.org/packages/ubuntu"
NGX_ORG_KEY_URL="https://nginx.org/keys/nginx_signing.key"
# Primary-key fingerprints published in nginx_signing.key. Every key in the
# downloaded file must be one of these; if nginx.org rotates its keys the
# install refuses until this list (and SPEC 6.3) is updated.
NGX_ORG_KEY_FPRS=(
    8540A6F18833A80E9C1653A42FD21310B49F6B46
    573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62
    9E9BE90EACBCDE69FE9B204CBCDCD8A38D88A2B3
)
NGX_MIN_MAJOR=1 NGX_MIN_MINOR=30 # stable 1.30 or newer (even minor = stable)
NGX_KEYRING="${EZVPS_KEYRING_DIR:-/usr/share/keyrings}/nginx-archive-keyring.gpg"
NGX_APT_DIR="${EZVPS_APT_DIR:-/etc/apt}"
NGX_APT_LIST="${NGX_APT_DIR}/sources.list.d/nginx.list"
NGX_APT_PREF="${NGX_APT_DIR}/preferences.d/99nginx"

# Filled by the helpers below.
NGX_ORG_REPO_URL="" NGX_CODENAME="" NGX_SRC="" NGX_PKGVER="" NGX_CAND=""
NGX_VER_MAJOR=0 NGX_VER_MINOR=0 NGX_VER_CLASS=""
NGX_KEY_FPS=() NGX_KEY_TMP="" NGX_PURGE_PKGS=()
NGX_REPO_UNDO_PATH=() NGX_REPO_UNDO_BK=()
NGX_RESTORED=() NGX_NOT_RESTORED=()

# ngx_select_repo: from the detected OS (detect_os), choose the nginx.org
# repository path and codename -> NGX_ORG_REPO_URL / NGX_CODENAME.
#   Debian 13    https://nginx.org/packages/debian  trixie
#   Ubuntu 24.04 https://nginx.org/packages/ubuntu  noble
ngx_select_repo() {
    local want
    NGX_ORG_REPO_URL="" NGX_CODENAME="${OS_CODENAME}"
    case "$OS_ID" in
        debian) NGX_ORG_REPO_URL="$NGX_ORG_REPO_DEBIAN" ;;
        ubuntu) NGX_ORG_REPO_URL="$NGX_ORG_REPO_UBUNTU" ;;
        *)
            err "nginx.org packages are only set up for Debian and Ubuntu; found '${OS_ID:-unknown}'. Nothing was changed."
            return 1
            ;;
    esac
    if [[ ! "$NGX_CODENAME" =~ ^[a-z]+$ ]]; then
        err "Could not read the ${OS_ID^} codename (VERSION_CODENAME) from ${EZVPS_OS_RELEASE:-/etc/os-release}; the nginx.org repository needs it. Nothing was changed."
        return 1
    fi
    want="$(os_expected_codename "$OS_ID" "$OS_VERSION")"
    if [[ -n "$want" && "$NGX_CODENAME" != "$want" ]]; then
        err "os-release says ${OS_PRETTY} but the codename '${NGX_CODENAME}' (expected '${want}'); refusing to guess the nginx.org repository. Nothing was changed."
        return 1
    fi
    return 0
}

# ngx_ver_parse <text>: first MAJOR.MINOR in the text -> NGX_VER_MAJOR/MINOR and
# NGX_VER_CLASS (ok = stable and new enough, old = below 1.30, mainline = odd minor).
ngx_ver_parse() {
    NGX_VER_MAJOR=0 NGX_VER_MINOR=0 NGX_VER_CLASS=""
    [[ "$1" =~ ([0-9]+)\.([0-9]+) ]] || return 1
    NGX_VER_MAJOR=$((10#${BASH_REMATCH[1]}))
    NGX_VER_MINOR=$((10#${BASH_REMATCH[2]}))
    if ((NGX_VER_MAJOR > NGX_MIN_MAJOR)); then
        NGX_VER_CLASS="ok"
    elif ((NGX_VER_MAJOR < NGX_MIN_MAJOR || NGX_VER_MINOR < NGX_MIN_MINOR)); then
        NGX_VER_CLASS="old"
    elif ((NGX_VER_MINOR % 2 == 1)); then
        NGX_VER_CLASS="mainline"
    else
        NGX_VER_CLASS="ok"
    fi
    return 0
}

# Version of the installed apt package "nginx" -> NGX_PKGVER (empty if not installed).
ngx_pkg_version() {
    local st
    NGX_PKGVER=""
    have_cmd dpkg-query || return 1
    # shellcheck disable=SC2016 # ${db:...} is a dpkg-query format, not a shell expansion
    st="$(dpkg-query -W -f='${db:Status-Abbrev}' nginx 2>/dev/null)"
    [[ "$st" == ii* ]] || return 1
    # shellcheck disable=SC2016
    NGX_PKGVER="$(dpkg-query -W -f='${Version}' nginx 2>/dev/null)"
    [[ -n "$NGX_PKGVER" ]]
}

# Where did the installed nginx come from? Sets NGX_SRC:
#   none       nothing installed
#   org-ok     nginx.org package, stable 1.30 or newer
#   org-bad    nginx.org package that is mainline or older than 1.30
#   other      an apt package that is not from nginx.org (for example the distribution's own)
#   unmanaged  an nginx command but no apt package (built by hand)
ngx_classify() {
    NGX_SRC="none"
    if ngx_pkg_version; then
        if [[ "$NGX_PKGVER" == *"~${NGX_CODENAME}" ]]; then
            ngx_ver_parse "$NGX_PKGVER" || NGX_VER_CLASS="old"
            if [[ "$NGX_VER_CLASS" == "ok" ]]; then
                NGX_SRC="org-ok"
            else
                NGX_SRC="org-bad"
            fi
        else
            NGX_SRC="other"
        fi
    elif have_cmd nginx; then
        NGX_SRC="unmanaged"
    fi
    return 0
}

# A mainline nginx.org source anywhere in apt's config would let the pin pick a
# mainline build. Prints the file name.
ngx_find_mainline_source() {
    local f line
    for f in "${NGX_APT_DIR}/sources.list" "${NGX_APT_DIR}"/sources.list.d/*; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            line="${line#"${line%%[![:space:]]*}"}"
            [[ "$line" == \#* ]] && continue
            if [[ "$line" == *nginx.org/packages/mainline* ]]; then
                printf '%s' "$f"
                return 0
            fi
        done <"$f"
    done
    return 1
}

# Download the signing key (the only network access of the Nginx module).
ngx_fetch_key() { # ngx_fetch_key <outfile>
    curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --connect-timeout 15 --max-time 60 \
        -o "$1" "$NGX_ORG_KEY_URL"
}

# ngx_key_fps <binary keyring file>: primary-key fingerprints -> NGX_KEY_FPS.
ngx_key_fps() {
    local gh line prev="" f
    NGX_KEY_FPS=()
    gh="$(mktemp -d)" || return 1
    while IFS= read -r line; do
        case "$line" in
            pub:*) prev="pub" ;;
            sub:* | sec:* | ssb:*) prev="other" ;;
            fpr:*)
                if [[ "$prev" == "pub" ]]; then
                    IFS=: read -ra f <<<"$line"
                    NGX_KEY_FPS+=("${f[9]^^}")
                fi
                prev="other"
                ;;
        esac
    done < <(GNUPGHOME="$gh" gpg --batch --with-colons --show-keys "$1" 2>/dev/null)
    rm -rf "$gh"
    ((${#NGX_KEY_FPS[@]} > 0))
}

ngx_cleanup_key_tmp() {
    [[ -n "$NGX_KEY_TMP" && -d "$NGX_KEY_TMP" ]] && rm -rf "$NGX_KEY_TMP"
    NGX_KEY_TMP=""
    return 0
}

# Download nginx_signing.key, convert it and verify every key in it against the
# pinned fingerprints. Leaves ${NGX_KEY_TMP}/key.gpg on success.
ngx_verify_key() {
    local gh fp known allowed bad=0
    NGX_KEY_TMP="$(mktemp -d)" || {
        err "Cannot create a temporary directory."
        return 1
    }
    info "Downloading the signing key: ${NGX_ORG_KEY_URL}"
    if ! ngx_fetch_key "${NGX_KEY_TMP}/key.asc"; then
        err "Download failed: ${NGX_ORG_KEY_URL}. Nothing was changed."
        return 1
    fi
    gh="$(mktemp -d)" || return 1
    if ! GNUPGHOME="$gh" gpg --batch --yes --dearmor -o "${NGX_KEY_TMP}/key.gpg" "${NGX_KEY_TMP}/key.asc" 2>/dev/null; then
        rm -rf "$gh"
        err "gpg could not read the downloaded key. Nothing was changed."
        return 1
    fi
    rm -rf "$gh"
    if ! ngx_key_fps "${NGX_KEY_TMP}/key.gpg"; then
        err "No key fingerprints found in the downloaded file. Nothing was changed."
        return 1
    fi
    for fp in "${NGX_KEY_FPS[@]}"; do
        allowed=0
        for known in "${NGX_ORG_KEY_FPRS[@]}"; do
            [[ "$fp" == "$known" ]] && allowed=1
        done
        if ((allowed == 1)); then
            info "  key fingerprint ${fp}: matches the pinned nginx.org key"
        else
            err "  key fingerprint ${fp}: NOT a pinned nginx.org key"
            bad=1
        fi
    done
    if ((bad == 1)); then
        err "Fingerprint check FAILED; the key is not trusted. Nothing was changed."
        return 1
    fi
    return 0
}

ngx_same_text() { # <a> <b>: same text content
    [[ -f "$1" && -f "$2" && "$(<"$1")" == "$(<"$2")" ]]
}

ngx_same_keyring() { # <new> <existing>: same set of primary fingerprints
    local mine
    ngx_key_fps "$1" || return 1
    mine="${NGX_KEY_FPS[*]}"
    ngx_key_fps "$2" || return 1
    [[ "$mine" == "${NGX_KEY_FPS[*]}" ]]
}

# ngx_put_file <src> <dest> <mode> <same-function>: install <src> as <dest>;
# an identical file is left alone, a different one is backed up first. What was
# done is recorded so ngx_repo_undo can put it back.
ngx_put_file() {
    local src="$1" dst="$2" mode="$3" same="$4" bk="" tmp
    if [[ -e "$dst" || -L "$dst" ]]; then
        if "$same" "$src" "$dst"; then
            info "  ${dst}: already up to date"
            return 0
        fi
        backup_file "$dst" "apt-${dst##*/}" || return 1
        bk="$BACKUP_FILE_PATH"
    fi
    if ! mkdir -p "${dst%/*}"; then
        err "Could not create ${dst%/*}."
        return 1
    fi
    tmp="${dst%/*}/.${dst##*/}.ezvps-tmp.$$"
    if ! { cp "$src" "$tmp" && chmod "$mode" "$tmp" && mv -f "$tmp" "$dst"; }; then
        rm -f "$tmp"
        err "Could not write ${dst}."
        return 1
    fi
    NGX_REPO_UNDO_PATH+=("$dst")
    NGX_REPO_UNDO_BK+=("$bk")
    info "  ${dst}: written${bk:+ (old file backed up to ${bk})}"
    return 0
}

ngx_repo_undo() {
    local i
    for i in "${!NGX_REPO_UNDO_PATH[@]}"; do
        rm -f "${NGX_REPO_UNDO_PATH[$i]}"
        [[ -n "${NGX_REPO_UNDO_BK[$i]}" ]] && cp -a "${NGX_REPO_UNDO_BK[$i]}" "${NGX_REPO_UNDO_PATH[$i]}"
    done
    if ((${#NGX_REPO_UNDO_PATH[@]} > 0)); then
        info "Rolled back the apt repository files written by this run."
    fi
    NGX_REPO_UNDO_PATH=() NGX_REPO_UNDO_BK=()
    return 0
}

# Keyring (verified key), apt source and the apt pin.
ngx_setup_repo() {
    NGX_REPO_UNDO_PATH=() NGX_REPO_UNDO_BK=()
    printf '%s\n' "deb [signed-by=${NGX_KEYRING}] ${NGX_ORG_REPO_URL} ${NGX_CODENAME} nginx" >"${NGX_KEY_TMP}/nginx.list" || return 1
    printf '%s\n' "Package: *" "Pin: origin nginx.org" "Pin-Priority: 900" >"${NGX_KEY_TMP}/99nginx" || return 1
    ngx_put_file "${NGX_KEY_TMP}/key.gpg" "$NGX_KEYRING" 644 ngx_same_keyring || return 1
    ngx_put_file "${NGX_KEY_TMP}/nginx.list" "$NGX_APT_LIST" 644 ngx_same_text || return 1
    ngx_put_file "${NGX_KEY_TMP}/99nginx" "$NGX_APT_PREF" 644 ngx_same_text || return 1
    return 0
}

# What apt would install for "nginx" now -> NGX_CAND.
ngx_apt_candidate() {
    local line
    NGX_CAND=""
    while IFS= read -r line; do
        if [[ "$line" =~ ^[[:space:]]*Candidate:[[:space:]]+([^[:space:]]+) ]]; then
            NGX_CAND="${BASH_REMATCH[1]}"
        fi
    done < <(LC_ALL=C apt-cache policy nginx 2>/dev/null)
    [[ -n "$NGX_CAND" && "$NGX_CAND" != "(none)" ]]
}

# The pin must make apt choose the nginx.org STABLE package; checked before
# anything is removed or installed.
ngx_check_candidate() {
    if ! ngx_apt_candidate; then
        err "apt has no installation candidate for nginx after adding the nginx.org repository"
        err "(does nginx.org publish packages for '${NGX_CODENAME}'?)."
        return 1
    fi
    if [[ "$NGX_CAND" != *"~${NGX_CODENAME}" ]]; then
        err "apt would install nginx ${NGX_CAND}, which is not the nginx.org package (expected a version ending in ~${NGX_CODENAME})."
        err "The repository pin is not taking effect; refusing to install."
        return 1
    fi
    ngx_ver_parse "$NGX_CAND" || NGX_VER_CLASS="old"
    case "$NGX_VER_CLASS" in
        ok) ;;
        mainline)
            err "apt would install nginx ${NGX_CAND}, a MAINLINE build. ezvps installs only the stable branch; refusing."
            return 1
            ;;
        *)
            err "apt would install nginx ${NGX_CAND}, which is older than ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR}; refusing."
            return 1
            ;;
    esac
    info "apt will install nginx ${NGX_CAND} from nginx.org (stable)."
    return 0
}

# After the install: `nginx -v` must report stable ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR}+ from the nginx.org package.
ngx_verify_version() {
    local v
    if ! have_cmd nginx; then
        err "nginx is not available (not in PATH) after the install; see the apt output above."
        return 1
    fi
    v="$(ngx_version)"
    if ngx_pkg_version && [[ "$NGX_PKGVER" != *"~${NGX_CODENAME}" ]]; then
        err "VERSION CHECK FAILED: the installed nginx is still the ${OS_ID^} package version (${NGX_PKGVER}), not nginx.org stable."
        return 1
    fi
    if ! ngx_ver_parse "$v"; then
        err "VERSION CHECK FAILED: could not read the version from 'nginx -v' (got '${v}')."
        return 1
    fi
    case "$NGX_VER_CLASS" in
        old)
            err "VERSION CHECK FAILED: ${v} is older than ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR}; nginx.org stable ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR} or newer is required."
            return 1
            ;;
        mainline)
            err "VERSION CHECK FAILED: ${v} is a mainline build (odd minor version); only the stable branch is allowed."
            return 1
            ;;
    esac
    info "Version check passes: ${v} (nginx.org stable)."
    return 0
}

# Installed apt packages that belong to a different nginx build (nginx, nginx-common, nginx-core,
# libnginx-mod-*, ...), including ones only left as config files.
ngx_pkgs_to_purge() {
    local st pkg
    NGX_PURGE_PKGS=()
    have_cmd dpkg-query || return 0
    while IFS=$'\t' read -r st pkg; do
        case "$st" in
            ii* | hi* | rc*) [[ -n "$pkg" ]] && NGX_PURGE_PKGS+=("$pkg") ;;
        esac
    done < <(
        # shellcheck disable=SC2016
        dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\n' 'nginx' 'nginx-*' 'libnginx-mod-*' 2>/dev/null
    )
    return 0
}

# ngx_restore_sites <backup of /etc/nginx>: after a replacement, bring back the
# ezvps-made sites (conf.d files and old-layout sites, which are then migrated
# to conf.d). Hand-written sites are not touched; they are listed.
ngx_restore_sites() {
    local bk="$1" f name d
    NGX_RESTORED=() NGX_NOT_RESTORED=()
    # old layout: put the files back where they were if the removal took them, then migrate
    for f in "$bk/sites-available"/*; do
        [[ -f "$f" && ! -L "$f" ]] || continue
        name="${f##*/}"
        ngx_read_site "$f" || continue
        if ((NGX_SITE_MANAGED == 1)); then
            if [[ ! -e "${NGX_AVAIL}/${name}" ]]; then
                mkdir -p "$NGX_AVAIL" && cp -a "$f" "${NGX_AVAIL}/${name}"
            fi
            if [[ -L "$bk/sites-enabled/${name}" && ! -e "${NGX_ENABLED}/${name}" && ! -L "${NGX_ENABLED}/${name}" ]]; then
                mkdir -p "$NGX_ENABLED" && ln -s "${NGX_AVAIL}/${name}" "${NGX_ENABLED}/${name}"
            fi
        elif [[ "$name" != "default" ]]; then
            NGX_NOT_RESTORED+=("sites-available/${name}")
        fi
    done
    ngx_legacy_scan
    if ((${#NGX_LEG_NAMES[@]} > 0)); then
        info "Moving the ezvps sites of the old layout to ${NGX_CONFD}..."
        ngx_migrate_run || true
    fi
    # conf.d: ezvps-made sites that are missing again
    for f in "$bk/conf.d"/*.conf; do
        [[ -f "$f" && ! -L "$f" ]] || continue
        name="${f##*/}"
        ngx_read_site "$f" || continue
        if ((NGX_SITE_MANAGED == 1)); then
            d="$NGX_SITE_DOMAIN"
            if ngx_valid_domain "$d" && [[ "$name" == "${d}.conf" && ! -e "${NGX_CONFD}/${name}" && ! -L "${NGX_CONFD}/${name}" ]]; then
                mkdir -p "$NGX_CONFD" && cp -a "$f" "${NGX_CONFD}/${name}" && NGX_RESTORED+=("${NGX_CONFD}/${name}")
            fi
        elif [[ "$name" != "default.conf" ]]; then
            NGX_NOT_RESTORED+=("conf.d/${name}")
        fi
    done
    if ((${#NGX_RESTORED[@]} > 0)); then
        if ngx_ensure_confd_include && ngx_config_test; then
            info "Restored ${#NGX_RESTORED[@]} ezvps site(s) to ${NGX_CONFD}. Config test passes."
            ngx_reload
        else
            err "The config test FAILED with the restored sites; nginx was NOT reloaded."
            ngx_print_test_output
            for f in "${NGX_RESTORED[@]}"; do rm -f "$f"; done
            err "The restored files were removed again. They are still in the backup: ${bk}"
        fi
    fi
    if ((${#NGX_NOT_RESTORED[@]} > 0)); then
        warn "Not restored automatically (not made by ezvps; they are in ${bk}):"
        for f in "${NGX_NOT_RESTORED[@]}"; do warn "  ${f}"; done
    fi
    return 0
}

# --- install -----------------------------------------------------------------

# Names who listens on a port (best effort; needs ss).
port_listener_info() {
    local out
    if have_cmd ss; then
        out="$(ss -H -ltnp "( sport = :$1 )" 2>/dev/null)"
        [[ -n "$out" ]] && {
            printf '%s' "$out"
            return 0
        }
    fi
    printf '(could not tell which program; run: ss -ltnp)'
}

ngx_install_plan() { # ngx_install_plan <replace 0|1> <tools to install...>
    local replace="$1" pkg
    shift
    info ""
    info "ezvps will install nginx ONLY from the official nginx.org STABLE repository"
    info "(not ${OS_ID^}'s package, not the mainline branch; stable ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR} or newer):"
    info "  repository: deb [signed-by=${NGX_KEYRING}] ${NGX_ORG_REPO_URL} ${NGX_CODENAME} nginx"
    info "  signing key: ${NGX_ORG_KEY_URL} (checked against pinned fingerprints, stored in ${NGX_KEYRING})"
    info "  apt pin:     ${NGX_APT_PREF} (origin nginx.org, priority 900), so upgrades stay on nginx.org stable"
    info "  then 'apt-get install nginx', a check with 'nginx -v' (abort if below ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR}, mainline or a ${OS_ID^} build),"
    info "  enable at boot and start. The firewall is not changed."
    if (($# > 0)); then
        info "  first: apt-get install ${*} (needed to fetch and check the key)"
    fi
    if ((replace == 1)); then
        warn ""
        if [[ "$NGX_SRC" == "org-bad" ]]; then
            warn "The installed nginx package ${NGX_PKGVER} is from nginx.org but is not stable ${NGX_MIN_MAJOR}.${NGX_MIN_MINOR}+."
        else
            warn "An nginx package that is not from nginx.org is installed (${NGX_PKGVER}; for example ${OS_ID^}'s). It will be REPLACED:"
        fi
        info "  1. ${NGX_DIR} is backed up to ${NGX_BACKUP_BASE}/nginx-etc.<timestamp>.<pid>"
        info "  2. the old package(s) are purged:${NGX_PURGE_PKGS[*]:+ ${NGX_PURGE_PKGS[*]}}"
        info "  3. the nginx.org package is installed"
        info "  4. ezvps-made sites are restored/moved to ${NGX_CONFD}; config test before any reload"
        info "     (hand-written sites are not restored automatically; they stay in the backup)"
    fi
    return 0
}

ngx_install() {
    require_root || return 0
    require_supported_os "Nginx install" || return 0
    ngx_select_repo || return 0
    ngx_classify

    case "$NGX_SRC" in
        org-ok)
            info ""
            info "Nginx is already installed ($(ngx_version || true); nginx.org stable package ${NGX_PKGVER}). Not reinstalling; current status:"
            if [[ ! -f "$NGX_APT_PREF" ]]; then
                warn "The apt pin ${NGX_APT_PREF} is missing, so apt could move nginx to another source on upgrade."
            fi
            ngx_status
            return 0
            ;;
        unmanaged)
            info ""
            info "Nginx is installed ($(ngx_version || true)) but not as an apt package, so ezvps will not replace it."
            info "Not reinstalling; current status:"
            ngx_status
            return 0
            ;;
    esac

    require_cmds apt-get apt-cache systemctl cp mkdir mv rm mktemp date chmod || return 0
    local src replace=0 tools=()
    if src="$(ngx_find_mainline_source)"; then
        err "A nginx.org MAINLINE source is configured in ${src}."
        err "ezvps installs only the stable branch and a mainline source would let apt pick a 1.31 build."
        err "Remove that source and try again. Nothing was changed."
        return 0
    fi
    if [[ "$NGX_SRC" != "none" ]]; then
        replace=1
        ngx_pkgs_to_purge
    elif port_in_use "$NGX_HTTP_PORT"; then
        warn ""
        warn "Port ${NGX_HTTP_PORT} is already in use by another service:"
        warn "  $(port_listener_info "$NGX_HTTP_PORT")"
        warn "nginx cannot start until that port is free."
        ask_yes_no "Install nginx anyway?" || {
            info "Cancelled. Nothing was changed."
            return 0
        }
    fi
    have_cmd curl || tools+=(curl)
    have_cmd gpg || tools+=(gnupg)
    ((${#tools[@]} > 0)) && tools+=(ca-certificates)
    ngx_install_plan "$replace" "${tools[@]}"
    ask_yes_no "Continue?" || {
        info "Cancelled. Nothing was changed."
        return 0
    }

    if ((${#tools[@]} > 0)); then
        DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${tools[@]}"
        if ! have_cmd curl || ! have_cmd gpg; then
            err "curl and gpg are still missing after the apt install; see the apt output above. Nothing else was changed."
            return 0
        fi
    fi

    # 1. key (verified), source and pin; apt must then pick nginx.org stable.
    if ! ngx_verify_key; then
        ngx_cleanup_key_tmp
        return 0
    fi
    info "Setting up the nginx.org stable repository:"
    if ! ngx_setup_repo; then
        ngx_cleanup_key_tmp
        ngx_repo_undo
        return 0
    fi
    ngx_cleanup_key_tmp
    if ! apt-get update -q; then
        err "apt-get update failed; the repository files were rolled back. Nothing else was changed."
        ngx_repo_undo
        return 0
    fi
    if ! ngx_check_candidate; then
        ngx_repo_undo
        info "The repository files were rolled back. Nothing else was changed."
        return 0
    fi

    # 2. replacing another nginx build: back up /etc/nginx, then purge it.
    local etc_bk=""
    if ((replace == 1)); then
        if [[ -e "$NGX_DIR" ]]; then
            backup_file "$NGX_DIR" "nginx-etc" || return 0
            etc_bk="$BACKUP_FILE_PATH"
        fi
        if ((${#NGX_PURGE_PKGS[@]} > 0)); then
            info "Removing the old nginx package(s): ${NGX_PURGE_PKGS[*]}"
            if ! DEBIAN_FRONTEND=noninteractive apt-get purge -y -q "${NGX_PURGE_PKGS[@]}"; then
                err "Removing the old package(s) failed; nginx.org was NOT installed. ${NGX_DIR} is backed up in ${etc_bk:-n/a}."
                return 0
            fi
        fi
    fi

    # 3. install from nginx.org and verify what we got.
    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y -q -o Dpkg::Options::=--force-confold nginx; then
        err "apt-get install nginx failed; see the output above."
        ((replace == 1)) && err "The old package was already removed. Your previous /etc/nginx is backed up in ${etc_bk:-n/a}."
        return 0
    fi
    if ! ngx_verify_version; then
        err "Aborting: nginx was NOT started and no site was restored."
        err "Check the apt pin (${NGX_APT_PREF}) and run: apt-cache policy nginx"
        ((replace == 1)) && err "Your previous /etc/nginx is backed up in ${etc_bk:-n/a}."
        return 0
    fi
    if ! systemctl enable --now "$NGX_SERVICE_NAME"; then
        err "systemctl enable --now ${NGX_SERVICE_NAME} failed."
    fi
    info ""
    if ngx_config_test; then
        info "Config test passes."
    else
        err "The nginx config test failed:"
        ngx_print_test_output
    fi

    # 4. bring the ezvps sites back (config test before any reload).
    if ((replace == 1)) && [[ -n "$etc_bk" ]]; then
        ngx_restore_sites "$etc_bk"
    fi
    ngx_verify_response
    info ""
    info "Nginx is installed ($(ngx_version)) from the nginx.org stable repository."
    info "Upgrades stay on nginx.org stable through the apt pin ${NGX_APT_PREF}."
    info "Add reverse-proxy sites with 'Add site' (they live in ${NGX_CONFD})."
    info "This module serves plain HTTP only. For HTTPS use the Certificates module"
    info "once it exists (not available yet)."
    return 0
}

# --- status / restart ----------------------------------------------------------

ngx_status() {
    if ! ngx_need_nginx; then
        return 0
    fi
    local state enabled="unknown" resp
    state="$(ngx_service_state)"
    if have_cmd systemctl; then
        enabled="$(systemctl is-enabled "$NGX_SERVICE_NAME" 2>/dev/null)" || true
        enabled="${enabled:-unknown}"
    fi
    info ""
    info "Nginx status"
    info "  Installed:    yes ($(ngx_version))"
    info "  Service:      ${NGX_SERVICE_NAME} - ${state} (boot: ${enabled})"
    if ngx_config_test; then
        info "  Config test:  passes"
    else
        err "  Config test:  FAILS (ezvps will not reload or restart nginx until it passes)"
        ngx_print_test_output
    fi
    if ngx_probe; then
        resp="yes (HTTP ${NGX_PROBE_CODE} on 127.0.0.1:${NGX_HTTP_PORT})"
    else
        resp="NO (nothing answered on 127.0.0.1:${NGX_HTTP_PORT})"
    fi
    info "  Responds:     ${resp}"
    return 0
}

ngx_restart() {
    ngx_need_nginx || return 0
    require_cmds systemctl || return 0
    info "Testing the nginx config first..."
    if ! ngx_config_test; then
        err "The config test FAILED. nginx was NOT restarted or reloaded."
        ngx_print_test_output
        err "Fix the config (see: nginx -t), then try again."
        return 0
    fi
    info "Config test passes. Restarting ${NGX_SERVICE_NAME}..."
    if ! systemctl restart "$NGX_SERVICE_NAME"; then
        err "systemctl restart ${NGX_SERVICE_NAME} failed. Check: journalctl -u ${NGX_SERVICE_NAME} -n 50"
        return 0
    fi
    ngx_verify_response
    return 0
}

# --- site helpers --------------------------------------------------------------

# Lowercase hostname with at least two labels, e.g. example.com.
ngx_valid_domain() {
    local d="$1"
    ((${#d} <= 253)) || return 1
    [[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$ ]]
}

ngx_valid_ipv4() {
    local ip="$1" o
    [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    local IFS=.
    for o in $ip; do
        ((10#$o <= 255)) || return 1
    done
    return 0
}

# ngx_parse_upstream <text>: accepts host:port, optionally with http://. Sets
# NGX_UP. Host may be an IPv4 address, a hostname or a [IPv6] address.
ngx_parse_upstream() {
    local u="$1" host port
    NGX_UP=""
    u="${u#"${u%%[![:space:]]*}"}"
    u="${u%"${u##*[![:space:]]}"}"
    if [[ "$u" == https://* ]]; then
        err "Only plain http upstreams are supported here (use host:port of a plain-HTTP backend)."
        return 1
    fi
    u="${u#http://}"
    u="${u%/}"
    if [[ "$u" =~ ^(\[[0-9a-fA-F:.]+\]):([0-9]{1,5})$ ]]; then
        host="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
    elif [[ "$u" =~ ^([^:/]+):([0-9]{1,5})$ ]]; then
        host="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        if [[ "$host" =~ ^[0-9.]+$ ]]; then
            ngx_valid_ipv4 "$host" || {
                err "Not a valid IPv4 address: ${host}"
                return 1
            }
        elif [[ ! "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
            err "Not a valid upstream host: ${host}"
            return 1
        fi
    else
        err "Upstream must look like host:port (for example 127.0.0.1:3000)."
        return 1
    fi
    if ((10#$port < 1 || 10#$port > 65535)); then
        err "Port must be between 1 and 65535."
        return 1
    fi
    NGX_UP="${host}:$((10#$port))"
    return 0
}

# ngx_read_site <file>: sets NGX_SITE_DOMAIN / NGX_SITE_UPSTREAM / NGX_SITE_MANAGED
# (1 = created by ezvps). For other files the first server_name is reported.
ngx_read_site() {
    local line first_name=""
    NGX_SITE_DOMAIN="" NGX_SITE_UPSTREAM="" NGX_SITE_MANAGED=0
    [[ -r "$1" ]] || return 1
    while IFS= read -r line; do
        case "$line" in
            "# Managed by ezvps"*) NGX_SITE_MANAGED=1 ;;
            "# ezvps:domain="*) NGX_SITE_DOMAIN="${line#\# ezvps:domain=}" ;;
            "# ezvps:upstream="*) NGX_SITE_UPSTREAM="${line#\# ezvps:upstream=}" ;;
            *)
                if [[ -z "$first_name" && "$line" =~ $NGX_SERVER_NAME_RE ]]; then
                    read -r first_name _ <<<"${BASH_REMATCH[1]}"
                fi
                ;;
        esac
    done <"$1"
    if ((NGX_SITE_MANAGED == 0)); then
        NGX_SITE_DOMAIN="$first_name"
        NGX_SITE_UPSTREAM=""
    fi
    NGX_SITE_DOMAIN="${NGX_SITE_DOMAIN//[[:cntrl:]]/}"
    NGX_SITE_UPSTREAM="${NGX_SITE_UPSTREAM//[[:cntrl:]]/}"
    return 0
}

# The IPv6 listener is only written when the kernel has IPv6; on a host booted
# without it, `listen [::]:80` makes `nginx -t` fail with "Address family not
# supported by protocol".
ngx_ipv6_available() { [[ -e "${EZVPS_IF_INET6_FILE:-/proc/net/if_inet6}" ]]; }

# shellcheck disable=SC2016 # nginx variables ($host ...) must stay literal
ngx_render_site() { # ngx_render_site <domain> <upstream>
    printf '%s\n' \
        "# Managed by ezvps (Nginx module). HTTP reverse proxy; edit via ezvps or keep the markers." \
        "# ezvps:domain=${1}" \
        "# ezvps:upstream=${2}" \
        "server {" \
        "    listen 80;"
    ngx_ipv6_available && printf '%s\n' "    listen [::]:80;"
    printf '%s\n' \
        "    server_name ${1};" \
        "" \
        "    location / {" \
        "        proxy_pass http://${2};" \
        "        proxy_http_version 1.1;" \
        '        proxy_set_header Host $host;' \
        '        proxy_set_header X-Real-IP $remote_addr;' \
        '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
        '        proxy_set_header X-Forwarded-Proto $scheme;' \
        '        proxy_set_header Upgrade $http_upgrade;' \
        '        proxy_set_header Connection "upgrade";' \
        "    }" \
        "}"
    return 0
}

# Another site file (not <domain>.conf itself) that already serves <domain>:
# any other conf.d/*.conf (default.conf is handled separately only in that it
# is offered for disabling), or a file in the legacy sites-enabled. Prints "conf.d/<file>" or
# "sites-enabled/<file>". Read-only.
ngx_find_conflict() {
    local f line tok code hit=0
    for f in "$NGX_CONFD"/*.conf "$NGX_ENABLED"/*; do
        [[ -f "$f" ]] || continue
        [[ "$f" == "${NGX_CONFD}/${1}.conf" || "$f" == "$NGX_DEFAULT_CONF" ]] && continue
        while IFS= read -r line; do
            code="${line%%#*}"
            if [[ "$code" =~ $NGX_SERVER_NAME_RE ]]; then
                for tok in ${BASH_REMATCH[1]}; do
                    [[ "$tok" == "$1" ]] && hit=1
                done
            fi
            ((hit == 1)) && break
        done <"$f"
        if ((hit == 1)); then
            if [[ "$f" == "${NGX_CONFD}/"* ]]; then
                printf 'conf.d/%s' "${f##*/}"
            else
                printf 'sites-enabled/%s' "${f##*/}"
            fi
            return 0
        fi
    done
    return 1
}

# The nginx.org package ships conf.d/default.conf (a "Welcome to nginx" server
# on port 80). It conflicts with a new site when it also listens on port 80
# (loaded first, it is the catch-all server for requests that match no
# server_name) or lists the domain itself. Only a default.conf that ezvps did
# not create is considered. Sets NGX_DEFAULT_REASON. Read-only.
NGX_DEFAULT_REASON=""
NGX_DEFAULT_CONF="${NGX_CONFD}/default.conf"
NGX_LISTEN80_RE='^[[:space:]]*listen[[:space:]]+(\[::\]:|[0-9.]+:)?80([[:space:];]|$)'
ngx_default_site_conflicts() {
    local f="$NGX_DEFAULT_CONF" line tok code listens=0 serves=0
    NGX_DEFAULT_REASON=""
    [[ -f "$f" ]] || return 1
    ngx_read_site "$f" || return 1
    ((NGX_SITE_MANAGED == 0)) || return 1
    while IFS= read -r line; do
        code="${line%%#*}"
        [[ "$code" =~ $NGX_LISTEN80_RE ]] && listens=1
        if [[ "$code" =~ $NGX_SERVER_NAME_RE ]]; then
            for tok in ${BASH_REMATCH[1]}; do
                [[ "$tok" == "$1" ]] && serves=1
            done
        fi
    done <"$f"
    if ((serves == 1)); then
        NGX_DEFAULT_REASON="it also serves ${1}"
        return 0
    fi
    if ((listens == 1)); then
        NGX_DEFAULT_REASON="it listens on port 80 too and, loaded first, answers every request that matches no server_name"
        return 0
    fi
    return 1
}

# ngx_clean_domain <text>: trim + lower-case, then accept only a plain hostname
# that is safe to use as a file name (letters, digits, dot, hyphen; no path
# separators). Sets REPLY_DOMAIN; prints why on rejection.
ngx_clean_domain() {
    local LC_ALL=C d="$1" shown
    REPLY_DOMAIN=""
    d="${d#"${d%%[![:space:]]*}"}"
    d="${d%"${d##*[![:space:]]}"}"
    d="${d,,}"
    shown="${d//[[:cntrl:]]/}"
    if [[ "$d" == */* || "$d" == *\\* ]]; then
        err "'${shown}' is not a valid domain name: it contains a path separator. Nothing was changed."
        return 1
    fi
    if [[ ! "$d" =~ ^[a-z0-9.-]+$ ]]; then
        err "'${shown}' is not a valid domain name: only letters, digits, dot and hyphen are allowed. Nothing was changed."
        return 1
    fi
    if ! ngx_valid_domain "$d"; then
        err "'${shown}' is not a valid domain name (use something like example.com). Nothing was changed."
        return 1
    fi
    REPLY_DOMAIN="$d"
    return 0
}

ngx_ask_domain() { # sets REPLY_DOMAIN
    local d
    REPLY_DOMAIN=""
    read -r -p "Domain (for example example.com): " d || {
        info ""
        return 1
    }
    if [[ -z "${d//[[:space:]]/}" ]]; then
        info "Cancelled. Nothing was changed."
        return 1
    fi
    ngx_clean_domain "$d"
}

# --- nginx.conf must include conf.d -----------------------------------------------------

NGX_HAS_HTTP=0 NGX_HAS_INCLUDE=0 NGX_INSERTED=0
NGX_INCLUDE_RE='^[[:space:]]*include[[:space:]]+[^;]*conf\.d/[^;]*\*[^;]*;'
NGX_HTTP_OPEN_RE='^[[:space:]]*http[[:space:]]*\{'

# ngx_scan_conf <file> [<out>]: a small brace-depth scan (comments ignored).
# Sets NGX_HAS_HTTP and NGX_HAS_INCLUDE (an `include .../conf.d/*...;` directly
# inside the http block). With <out>, writes a copy of <file> that has the
# include added just before the closing brace of the http block
# (NGX_INSERTED=1 when that worked).
ngx_scan_conf() {
    local line code trimmed depth=0 http_in=0 pre o c
    NGX_HAS_HTTP=0 NGX_HAS_INCLUDE=0 NGX_INSERTED=0
    [[ -n "${2:-}" ]] && : >"$2"
    while IFS= read -r line || [[ -n "$line" ]]; do
        code="${line%%#*}"
        trimmed="${code#"${code%%[![:space:]]*}"}"
        trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
        pre=$depth
        if ((http_in == 0 && depth == 0)) && [[ "$code" =~ $NGX_HTTP_OPEN_RE ]]; then
            NGX_HAS_HTTP=1
            http_in=$((depth + 1))
        fi
        if ((http_in > 0 && pre == http_in)); then
            if [[ "$code" =~ $NGX_INCLUDE_RE ]]; then
                NGX_HAS_INCLUDE=1
            elif [[ "$trimmed" == "}" && -n "${2:-}" && $NGX_INSERTED -eq 0 ]]; then
                printf '%s\n' "    # added by ezvps: per-domain sites live in conf.d" \
                    "    include ${NGX_CONFD}/*.conf;" >>"$2"
                NGX_INSERTED=1
            fi
        fi
        [[ -n "${2:-}" ]] && printf '%s\n' "$line" >>"$2"
        o="${code//[^\{]/}"
        c="${code//[^\}]/}"
        depth=$((depth + ${#o} - ${#c}))
        ((depth < http_in)) && http_in=0
    done <"$1"
    return 0
}

ngx_has_confd_include() {
    [[ -r "$NGX_CONF" ]] || return 1
    ngx_scan_conf "$NGX_CONF"
    ((NGX_HAS_INCLUDE == 1))
}

# Make sure conf.d exists and nginx.conf includes it. A missing include is
# added inside the http block after a backup of nginx.conf, then `nginx -t`
# must pass; otherwise nginx.conf is restored. Non-zero = not safe to go on.
ngx_ensure_confd_include() {
    local bk tmp
    if [[ ! -f "$NGX_CONF" ]]; then
        err "${NGX_CONF} not found; cannot check that it includes ${NGX_CONFD}."
        return 1
    fi
    if ! mkdir -p "$NGX_CONFD"; then
        err "Could not create ${NGX_CONFD}."
        return 1
    fi
    ngx_has_confd_include && return 0
    info ""
    warn "${NGX_CONF} does not include ${NGX_CONFD}/*.conf, so sites there would not be loaded."
    info "ezvps will back up nginx.conf and add 'include ${NGX_CONFD}/*.conf;' inside its http block."
    backup_file "$NGX_CONF" "nginx.conf" || return 1
    bk="$BACKUP_FILE_PATH"
    tmp="${NGX_DIR}/.nginx.conf.ezvps-tmp.$$"
    ngx_scan_conf "$NGX_CONF" "$tmp"
    if ((NGX_INSERTED == 0)); then
        rm -f "$tmp"
        if ((NGX_HAS_HTTP == 0)); then
            err "Found no http block in ${NGX_CONF}. Add this line inside http { } yourself:"
        else
            err "Could not find the end of the http block in ${NGX_CONF}. Add this line inside http { } yourself:"
        fi
        err "    include ${NGX_CONFD}/*.conf;"
        return 1
    fi
    if ! cp "$tmp" "$NGX_CONF"; then
        rm -f "$tmp"
        cp -a "$bk" "$NGX_CONF" 2>/dev/null
        err "Could not write ${NGX_CONF}; the original was kept (backup: ${bk})."
        return 1
    fi
    rm -f "$tmp"
    if ! ngx_config_test; then
        err "The nginx config test FAILED after adding the conf.d include; nginx was NOT reloaded."
        ngx_print_test_output
        if cp -a "$bk" "$NGX_CONF"; then
            info "Rolled back: ${NGX_CONF} was restored from ${bk}."
        else
            err "ROLLBACK PROBLEM: restore ${NGX_CONF} from ${bk} by hand."
        fi
        return 1
    fi
    info "Added the conf.d include to ${NGX_CONF}. Config test passes."
    return 0
}

# --- legacy layout (sites-available + sites-enabled) --------------------------------------
# ezvps no longer creates or manages sites there. Only the migration below
# reads those directories, and only for files carrying the ezvps marker.

NGX_LEG_NAMES=() NGX_LEG_DOMAINS=() NGX_LEG_STAY=()
NGX_MIG_BK_A=() NGX_MIG_BK_E=() NGX_MIG_COPIED=()

# Fills NGX_LEG_NAMES/NGX_LEG_DOMAINS (movable) and NGX_LEG_STAY (legacy
# ezvps sites that cannot be moved safely, with the reason).
ngx_legacy_scan() {
    local f name d
    NGX_LEG_NAMES=() NGX_LEG_DOMAINS=() NGX_LEG_STAY=()
    [[ -d "$NGX_AVAIL" ]] || return 0
    for f in "$NGX_AVAIL"/*; do
        [[ -f "$f" && ! -L "$f" ]] || continue
        name="${f##*/}"
        ngx_read_site "$f" || continue
        ((NGX_SITE_MANAGED == 1)) || continue
        d="$NGX_SITE_DOMAIN"
        name="${name//[[:cntrl:]]/}"
        if ! ngx_valid_domain "$d"; then
            NGX_LEG_STAY+=("${name} (its ezvps:domain marker is not a valid domain)")
        elif [[ ! -L "${NGX_ENABLED}/${name}" || "$(readlink "${NGX_ENABLED}/${name}")" != "$f" ]]; then
            NGX_LEG_STAY+=("${name} (not enabled by a symlink to this file; moving it would switch it on)")
        elif [[ -e "${NGX_CONFD}/${d}.conf" || -L "${NGX_CONFD}/${d}.conf" ]]; then
            NGX_LEG_STAY+=("${name} (conf.d/${d}.conf already exists)")
        else
            NGX_LEG_NAMES+=("$name")
            NGX_LEG_DOMAINS+=("$d")
        fi
    done
    return 0
}

# Put everything the migration touched back as it was.
ngx_migrate_rollback() {
    local i a e ok=0
    for i in "${!NGX_LEG_NAMES[@]}"; do
        a="${NGX_AVAIL}/${NGX_LEG_NAMES[$i]}"
        e="${NGX_ENABLED}/${NGX_LEG_NAMES[$i]}"
        if [[ -n "${NGX_MIG_COPIED[$i]:-}" ]]; then
            rm -f "${NGX_CONFD}/${NGX_LEG_DOMAINS[$i]}.conf" || ok=1
        fi
        if [[ -n "${NGX_MIG_BK_A[$i]:-}" && ! -e "$a" ]]; then
            cp -a "${NGX_MIG_BK_A[$i]}" "$a" || ok=1
        fi
        if [[ -n "${NGX_MIG_BK_E[$i]:-}" && ! -e "$e" && ! -L "$e" ]]; then
            cp -a "${NGX_MIG_BK_E[$i]}" "$e" || ok=1
        fi
    done
    if ((ok != 0)); then
        err "ROLLBACK PROBLEM: the legacy files could not all be restored; see the backups in ${NGX_BACKUP_BASE}."
        return 1
    fi
    info "Rolled back: the legacy files are as they were."
    return 0
}

# Copy to conf.d, test, and only then remove the legacy symlink and file.
ngx_migrate_run() {
    local i name dom a e
    require_cmds cp mkdir rm date chmod readlink || return 1
    NGX_MIG_BK_A=() NGX_MIG_BK_E=() NGX_MIG_COPIED=()
    if ! ngx_ensure_confd_include; then
        err "Migration not done: nginx.conf must load conf.d first. Nothing was moved."
        return 1
    fi
    for i in "${!NGX_LEG_NAMES[@]}"; do
        name="${NGX_LEG_NAMES[$i]}"
        dom="${NGX_LEG_DOMAINS[$i]}"
        backup_file "${NGX_AVAIL}/${name}" "nginx-legacy-${dom}" || return 1
        NGX_MIG_BK_A[i]="$BACKUP_FILE_PATH"
        backup_file "${NGX_ENABLED}/${name}" "nginx-legacy-${dom}.enabled" || return 1
        NGX_MIG_BK_E[i]="$BACKUP_FILE_PATH"
    done
    for i in "${!NGX_LEG_NAMES[@]}"; do
        if ! cp -a "${NGX_AVAIL}/${NGX_LEG_NAMES[$i]}" "${NGX_CONFD}/${NGX_LEG_DOMAINS[$i]}.conf"; then
            err "Could not copy ${NGX_LEG_NAMES[$i]} to ${NGX_CONFD}."
            ngx_migrate_rollback
            return 1
        fi
        NGX_MIG_COPIED[i]=1
    done
    if ! ngx_config_test; then
        err "The nginx config test FAILED with the copies in conf.d; nothing was removed and nginx was NOT reloaded."
        ngx_print_test_output
        ngx_migrate_rollback
        return 1
    fi
    info "Copied to ${NGX_CONFD}. Config test passes; removing the legacy symlinks and files..."
    for i in "${!NGX_LEG_NAMES[@]}"; do
        a="${NGX_AVAIL}/${NGX_LEG_NAMES[$i]}"
        e="${NGX_ENABLED}/${NGX_LEG_NAMES[$i]}"
        if ! rm -f "$e" "$a"; then
            err "Could not remove the legacy files of ${NGX_LEG_NAMES[$i]}."
            ngx_migrate_rollback
            return 1
        fi
    done
    if ! ngx_config_test; then
        err "The nginx config test FAILED after removing the legacy files; nginx was NOT reloaded."
        ngx_print_test_output
        ngx_migrate_rollback
        return 1
    fi
    info "Moved ${#NGX_LEG_NAMES[@]} site(s) to ${NGX_CONFD}. Config test passes."
    ngx_reload
    return 0
}

# Offer to move legacy ezvps sites to conf.d; warn about whatever is left.
ngx_offer_migration() {
    local i n
    ngx_legacy_scan
    ((${#NGX_LEG_NAMES[@]} + ${#NGX_LEG_STAY[@]} > 0)) || return 0
    if ((${#NGX_LEG_NAMES[@]} > 0)); then
        info ""
        info "ezvps sites from the old layout were found in ${NGX_AVAIL}."
        info "ezvps now keeps its sites in ${NGX_CONFD}, one <domain>.conf per domain."
        for i in "${!NGX_LEG_NAMES[@]}"; do
            info "  ${NGX_AVAIL}/${NGX_LEG_NAMES[$i]}  ->  ${NGX_CONFD}/${NGX_LEG_DOMAINS[$i]}.conf"
        done
        info "Moving backs the files up, copies them to conf.d, runs the config test, and only"
        info "after it passes removes the sites-enabled symlink and the sites-available file."
        if ask_yes_no "Move these site(s) to ${NGX_CONFD} now?"; then
            ngx_migrate_run || true
        else
            info "Migration declined. Those files were left alone."
        fi
    fi
    ngx_legacy_scan
    n=$((${#NGX_LEG_NAMES[@]} + ${#NGX_LEG_STAY[@]}))
    if ((n > 0)); then
        warn ""
        warn "${n} ezvps site(s) are still in the legacy layout (sites-available / sites-enabled); ezvps no longer manages them:"
        for i in "${!NGX_LEG_NAMES[@]}"; do
            warn "  ${NGX_LEG_NAMES[$i]}"
        done
        for i in "${!NGX_LEG_STAY[@]}"; do
            warn "  ${NGX_LEG_STAY[$i]}"
        done
        warn "They keep working and were not changed. Open List sites, Add site or Remove site again to be offered the move."
    fi
    return 0
}

# --- list ------------------------------------------------------------------------

ngx_list_sites() {
    ngx_installed || {
        info "Nginx is not installed. Choose 'Install Nginx' first."
        return 0
    }
    ngx_offer_migration || true
    local f name shown=0 dom
    info ""
    info "Sites (${NGX_CONFD}/*.conf):"
    for f in "$NGX_CONFD"/*.conf; do
        [[ -e "$f" || -L "$f" ]] || continue
        name="${f##*/}"
        name="${name//[[:cntrl:]]/}"
        if ((shown == 0)); then
            printf '  %-32s %-28s %-24s %s\n' "NAME" "DOMAIN" "UPSTREAM" "CREATED BY"
            shown=1
        fi
        if [[ ! -f "$f" ]]; then
            printf '  %-32s %-28s %-24s %s\n' "$name" "-" "-" "(broken symlink or not a file)"
            continue
        fi
        ngx_read_site "$f" || true
        dom="${NGX_SITE_DOMAIN:--}"
        if ((NGX_SITE_MANAGED == 1)); then
            printf '  %-32s %-28s %-24s %s\n' "$name" "$dom" "${NGX_SITE_UPSTREAM:--}" "ezvps"
        else
            printf '  %-32s %-28s %-24s %s\n' "$name" "$dom" "-" "not ezvps"
        fi
    done
    ((shown == 0)) && info "  (none)"
    if [[ -f "$NGX_CONF" ]] && ! ngx_has_confd_include; then
        warn ""
        warn "${NGX_CONF} does not include ${NGX_CONFD}/*.conf: sites listed here are not loaded."
        warn "Add site fixes that (with a backup and a config test)."
    fi
    return 0
}

# --- add ---------------------------------------------------------------------------

# ngx_rollback_site <file> <backup|""> <default_conf_backup|"">
ngx_rollback_site() {
    local ok=0
    rm -f "$1" || ok=1
    [[ -n "$2" ]] && { cp -a "$2" "$1" || ok=1; }
    if [[ -n "$3" ]]; then
        rm -f "${NGX_DEFAULT_CONF}.disabled" "$NGX_DEFAULT_CONF"
        cp -a "$3" "$NGX_DEFAULT_CONF" || ok=1
    fi
    if ((ok != 0)); then
        err "ROLLBACK PROBLEM: could not fully restore ${1}. Backups: ${2:-none} ${3:-}"
        return 1
    fi
    info "Rolled back: the previous state was restored."
    return 0
}

ngx_add_site() {
    ngx_need_nginx || return 0
    require_cmds cp mkdir mv rm date chmod systemctl || return 0
    ngx_offer_migration || true
    local domain upstream_raw f conflict tmp up old_bk="" default_bk=""
    ngx_ask_domain || return 0
    domain="$REPLY_DOMAIN"
    read -r -p "Upstream address with port (for example 127.0.0.1:3000): " upstream_raw || {
        info ""
        return 0
    }
    ngx_parse_upstream "$upstream_raw" || {
        info "Nothing was changed."
        return 0
    }
    up="$NGX_UP"
    f="${NGX_CONFD}/${domain}.conf"

    if conflict="$(ngx_find_conflict "$domain")"; then
        err "${domain} is already served by another nginx site file: ${conflict}."
        err "Remove or edit that site first so the domain is not defined twice. Nothing was changed."
        return 0
    fi

    if [[ -e "$f" || -L "$f" ]]; then
        if [[ ! -f "$f" ]]; then
            err "${f} exists but is not a regular file. Nothing was changed."
            return 0
        fi
        ngx_read_site "$f" || true
        if ((NGX_SITE_MANAGED == 1)) && [[ "$NGX_SITE_DOMAIN" == "$domain" && "$NGX_SITE_UPSTREAM" == "$up" ]]; then
            info ""
            info "${domain} already exists with the same upstream (${up}). Nothing to do."
            return 0
        fi
        info ""
        info "A site for ${domain} already exists:"
        if ((NGX_SITE_MANAGED == 1)); then
            info "  ${f}  (created by ezvps, upstream ${NGX_SITE_UPSTREAM:-unknown})"
        else
            info "  ${f}  (NOT created by ezvps)"
        fi
        ask_yes_no "Overwrite it with a reverse proxy to ${up}? The old file is backed up first." || {
            info "Cancelled. Nothing was changed."
            return 0
        }
        backup_file "$f" "nginx-site-${domain}" || return 0
        old_bk="$BACKUP_FILE_PATH"
    fi

    # The nginx.org default site (conf.d/default.conf): offer to disable it.
    # It is backed up and renamed to default.conf.disabled, never deleted.
    if ngx_default_site_conflicts "$domain"; then
        warn ""
        warn "The nginx.org default site (${NGX_DEFAULT_CONF}) may conflict with ${domain}: ${NGX_DEFAULT_REASON}."
        if [[ -L "$NGX_DEFAULT_CONF" ]]; then
            warn "It is a symlink, so ezvps will not touch it."
        elif ask_yes_no "Disable the default site? It is backed up and renamed to default.conf.disabled (not deleted)."; then
            backup_file "$NGX_DEFAULT_CONF" "nginx-default-conf" || return 0
            default_bk="$BACKUP_FILE_PATH"
        else
            info "Leaving the default site enabled."
        fi
    fi

    ngx_ensure_confd_include || {
        info "The site was not added."
        return 0
    }

    tmp="${NGX_CONFD}/.${domain}.ezvps-tmp.$$"
    if ! { ngx_render_site "$domain" "$up" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$f"; }; then
        rm -f "$tmp"
        err "Could not write ${f}. Nothing was changed."
        return 0
    fi
    if [[ -n "$default_bk" ]] && ! mv -f "$NGX_DEFAULT_CONF" "${NGX_DEFAULT_CONF}.disabled"; then
        err "Could not disable the default site."
        ngx_rollback_site "$f" "$old_bk" "$default_bk"
        return 0
    fi

    if ! ngx_config_test; then
        err "The nginx config test FAILED after adding ${domain}; nginx was NOT reloaded."
        ngx_print_test_output
        ngx_rollback_site "$f" "$old_bk" "$default_bk"
        return 0
    fi
    info "Site ${domain} -> ${up} written to ${f}. Config test passes."
    [[ -n "$default_bk" ]] && info "The nginx.org default site was disabled: ${NGX_DEFAULT_CONF} is now default.conf.disabled (backup: ${default_bk})."
    ngx_reload
    if [[ "$up" == 127.0.0.1:* || "$up" == localhost:* ]] && ! port_in_use "${up##*:}"; then
        warn "Nothing is listening on ${up} right now; visitors get a 502 until the backend is up."
    fi
    info ""
    info "Point the DNS record of ${domain} at this server and make sure port 80 is open."
    info "This site is HTTP only. If it needs HTTPS, use the Certificates module once it"
    info "exists (not available yet); this module does not touch certificates."
    return 0
}

# --- remove --------------------------------------------------------------------------

ngx_remove_site() {
    ngx_need_nginx || return 0
    require_cmds cp mkdir rm date chmod systemctl || return 0
    ngx_offer_migration || true
    local domain f bk=""
    ngx_ask_domain || return 0
    domain="$REPLY_DOMAIN"
    f="${NGX_CONFD}/${domain}.conf"
    if [[ ! -e "$f" && ! -L "$f" ]]; then
        info "No site named ${domain} in ${NGX_CONFD}. Nothing was changed."
        return 0
    fi
    if [[ ! -f "$f" ]]; then
        err "${f} is not a regular file; ezvps will not remove it. Nothing was changed."
        return 0
    fi
    info ""
    info "Site ${domain}:"
    ngx_read_site "$f" || true
    if ((NGX_SITE_MANAGED == 1)); then
        info "  ${f}  (created by ezvps, upstream ${NGX_SITE_UPSTREAM:-unknown})"
    else
        warn "  ${f}  (NOT created by ezvps - it was written by hand or another tool)"
    fi
    ask_yes_no "Remove ${domain}? A backup of the file is kept." || {
        info "Cancelled. Nothing was changed."
        return 0
    }
    backup_file "$f" "nginx-site-${domain}" || return 0
    bk="$BACKUP_FILE_PATH"
    if ! rm -f "$f"; then
        err "Could not remove ${f}."
        ngx_rollback_site "$f" "$bk" ""
        return 0
    fi
    if ! ngx_config_test; then
        err "The nginx config test FAILED after removing ${domain}; nginx was NOT reloaded."
        ngx_print_test_output
        ngx_rollback_site "$f" "$bk" ""
        return 0
    fi
    info "Site ${domain} removed. Config test passes."
    ngx_reload
    return 0
}

# --- submenu -------------------------------------------------------------------------

NGX_MENU_LABELS=("Install Nginx" "Status" "Restart" "List sites" "Add site" "Remove site")

module_nginx() {
    local choice i
    while true; do
        info ""
        info "${C_BOLD}Nginx${C_RESET}"
        info ""
        for i in "${!NGX_MENU_LABELS[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${NGX_MENU_LABELS[$i]}"
        done
        printf '%2d) %s\n' 0 "Back"
        info ""
        if ! read -r -p "Select: " choice; then
            info ""
            return 0
        fi
        choice="${choice//[[:space:]]/}"
        case "$choice" in
            0) return 0 ;;
            1) ngx_install || true ;;
            2) ngx_status || true ;;
            3) ngx_restart || true ;;
            4) ngx_list_sites || true ;;
            5) ngx_add_site || true ;;
            6) ngx_remove_site || true ;;
            *)
                warn "Invalid choice: ${choice:-<empty>}"
                ;;
        esac
        pause "Press Enter to continue... " || true
    done
}

# Dispatch a module by key. Always returns 0 so a module can never take the
# menu down; real failures are reported by the module itself.
run_module() {
    case "$1" in
        l2tp) module_l2tp ;;
        3x-ui) module_3x_ui ;;
        nginx) module_nginx ;;
        backpack | ctunnel | certs | lazyports | ssh | firewall | backup | update | uninstall)
            module_not_implemented "$1"
            ;;
        *)
            err "Unknown module: $1"
            return 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Menu
# ---------------------------------------------------------------------------

print_menu() {
    local i
    info "${C_BOLD}ezvps ${EZVPS_VERSION}${C_RESET}"
    info ""
    for i in "${!MODULE_LABELS[@]}"; do
        printf '%2d) %s\n' "$((i + 1))" "${MODULE_LABELS[$i]}"
    done
    printf '%2d) %s\n' 0 "Exit"
    info ""
}

main_menu() {
    local choice
    while true; do
        clear_screen
        print_menu
        if ! read -r -p "Select: " choice; then
            info ""
            return 0 # EOF on stdin: leave cleanly
        fi
        choice="${choice//[[:space:]]/}"
        if [[ "$choice" == "0" ]]; then
            return 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && ((10#$choice >= 1 && 10#$choice <= ${#MODULE_KEYS[@]})); then
            run_module "${MODULE_KEYS[$((10#$choice - 1))]}"
            pause || true
        else
            warn "Invalid choice: ${choice:-<empty>}"
            pause || true
        fi
    done
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

usage() {
    info "ezvps ${EZVPS_VERSION} - VPS manager for Debian 13 and Ubuntu 24.04 LTS

Usage:
  ezvps                 open the interactive menu
  ezvps <module>        run one module directly
  ezvps --version       print the version
  ezvps --help          show this help

Modules:
  l2tp 3x-ui backpack ctunnel nginx certs lazyports ssh firewall
  backup update uninstall

Only l2tp, 3x-ui and nginx are implemented in this release; the others report
that they are not implemented yet."
}

require_root() {
    if ((EUID != 0)) && [[ "${EZVPS_ALLOW_NONROOT:-0}" != "1" ]]; then
        err "ezvps must be run as root."
        return 1
    fi
    return 0
}

main() {
    case "${1:-}" in
        -h | --help | help)
            usage
            return 0
            ;;
        -V | --version | version)
            info "ezvps ${EZVPS_VERSION}"
            return 0
            ;;
        "" | menu)
            require_root || return 1
            main_menu
            return $?
            ;;
        *)
            local key="$1" known=0 k
            for k in "${MODULE_KEYS[@]}"; do
                [[ "$k" == "$key" ]] && known=1
            done
            if ((known == 0)); then
                err "Unknown command: $key"
                usage >&2
                return 2
            fi
            require_root || return 1
            run_module "$key"
            return $?
            ;;
    esac
}

main "$@"
