# ---------------------------------------------------------------------------
# Firewall module (PR 11)
#
# Show status, list rules, allow a port and remove a rule through the ONE
# firewall backend that is present on the system: ufw, then firewalld, then
# nftables, then iptables (the first one found wins; SPEC 6.9). Only that
# backend's documented commands are used. ezvps never installs a firewall, never
# enables, disables, resets or flushes one, never removes more than the single
# rule the user picked, and warns and asks separately before it removes a rule
# that keeps SSH reachable. Backend output is parsed in pure bash (no sed, awk or
# grep) with LC_ALL=C so translated output cannot break the parsing. Helpers are
# prefixed fw_.
# ---------------------------------------------------------------------------

FW_BACKENDS=(ufw firewalld nftables iptables) # detection order: the first one present wins
FW_BACKEND=""
FW_STATE="" FW_DEFAULT=""
FW_OUT=""

# The parsed rule list: parallel arrays, one entry per rule, in the backend's own order.
#   ID     what the user types (ufw/iptables: rule number; nftables: handle; firewalld: row number)
#   ACTION the backend's own word (allow, deny, accept, drop, ...); PROTO/PORT/SOURCE as reported, "-" if none
#   RAW    the rule as the backend reports it;  KEY identifies it for the backend's remove command
#   COVER  "ports[/proto]" tokens the rule opens (used for duplicate and SSH checks)
#   GROUP  where the rule lives (firewalld zone, nftables "family table chain", iptables chain)
FW_ID=() FW_ACTION=() FW_PROTO=() FW_PORT=() FW_SRC=() FW_RAW=() FW_KEY=() FW_COVER=() FW_GROUP=()
FW_NOTES=()
FW_RULES_TEXT=""
FW_UFW_APPS=()
FW_ZONES=() FW_ZONE_DEFAULT=""
FW_NFT_CHAINS=() FW_NFT_POLICIES=()
FW_IPT_POLICY=""
FW_P_ACTION="" FW_P_PROTO="" FW_P_PORT="" FW_P_SRC="" FW_P_COVER=""
FW_REQ_PORT="" FW_REQ_PROTO="" FW_ADD_GROUP=""
FW_MATCH=() FW_LISTENERS=() FW_LISTEN_NOTE=""
FW_SSH_PORTS=() FW_SSH_WHY=""
FW_PARTIAL=0 # 1 when a firewalld change reached the running firewall but not the permanent configuration

fw_clean() { printf '%s' "${1//[^[:print:]]/?}"; } # input echoed back in a message: no control characters

# Runs a backend command in the C locale; output (stdout + stderr) in FW_OUT, status returned.
fw_run() { FW_OUT="$(LC_ALL=C "$@" 2>&1)"; }

# --- detection -----------------------------------------------------------------

fw_backend_cmd() { # fw_backend_cmd <backend>: the command that proves the backend is present
    case "$1" in
        ufw) printf 'ufw' ;;
        firewalld) printf 'firewall-cmd' ;;
        nftables) printf 'nft' ;;
        iptables) printf 'iptables' ;;
    esac
}

# Sets FW_BACKEND to the first backend, in the fixed order, whose command exists.
fw_detect() {
    local b
    FW_BACKEND=""
    for b in "${FW_BACKENDS[@]}"; do
        if have_cmd "$(fw_backend_cmd "$b")"; then
            FW_BACKEND="$b"
            return 0
        fi
    done
    return 1
}

fw_need_backend() {
    if ! fw_detect; then
        warn "No firewall backend found (looked for, in this order: ufw, firewalld, nftables, iptables)."
        info "ezvps does not install a firewall tool. Nothing was changed."
        return 1
    fi
    info "Firewall backend: ${FW_BACKEND} (command: $(fw_backend_cmd "$FW_BACKEND"))"
    return 0
}

# --- validation ------------------------------------------------------------------

fw_valid_port() { [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]] && ((10#$1 <= 65535)); } # digits only, no leading zero, 1-65535
fw_norm_proto() { # fw_norm_proto <text>: prints tcp or udp (any case), nothing else is accepted
    local p="${1,,}"
    case "$p" in
        tcp | udp) printf '%s' "$p" ;;
        *) return 1 ;;
    esac
}

# --- the parsed rule list ----------------------------------------------------------

fw_rules_clear() {
    FW_ID=() FW_ACTION=() FW_PROTO=() FW_PORT=() FW_SRC=() FW_RAW=() FW_KEY=() FW_COVER=() FW_GROUP=()
    FW_NOTES=() FW_RULES_TEXT=""
}

fw_rule_add() { # fw_rule_add <id> <action> <proto> <port> <src> <raw> <key> <cover> <group>
    FW_ID+=("$1") FW_ACTION+=("$2") FW_PROTO+=("$3") FW_PORT+=("$4") FW_SRC+=("$5")
    FW_RAW+=("$6") FW_KEY+=("$7") FW_COVER+=("$8") FW_GROUP+=("$9")
}

fw_act_allows() { # an action that lets traffic in (ufw "limit" is an allow with rate limiting)
    case "$1" in allow | "allow in" | accept | limit | "limit in") return 0 ;; esac
    return 1
}
fw_act_blocks() {
    case "$1" in deny | "deny in" | reject | "reject in" | drop) return 0 ;; esac
    return 1
}
fw_src_open() { # no source restriction
    case "$1" in "" | - | Anywhere* | anywhere* | 0.0.0.0/0 | ::/0) return 0 ;; esac
    return 1
}

# fw_cover_has <tokens> <port> <proto>: does one of the "<ports>[/<proto>]" tokens cover port/proto?
# <ports> is a comma list of N, A:B or A-B; a token without /proto covers both protocols.
fw_cover_has() {
    local toks tok items item pr
    read -ra toks <<<"$1"
    for tok in "${toks[@]}"; do
        pr=""
        [[ "$tok" == */* ]] && pr="${tok#*/}"
        [[ -z "$pr" || "$pr" == "$3" ]] || continue
        IFS=, read -ra items <<<"${tok%%/*}"
        for item in "${items[@]}"; do
            if [[ "$item" =~ ^([0-9]+)[:-]([0-9]+)$ ]]; then
                ((10#${BASH_REMATCH[1]} <= $2 && $2 <= 10#${BASH_REMATCH[2]})) && return 0
            elif [[ "$item" =~ ^[0-9]+$ ]]; then
                ((10#$item == $2)) && return 0
            fi
        done
    done
    return 1
}

# fw_find_rows <allow|block> <port> <proto> [group]: FW_MATCH gets the indexes of rules that
# already allow (from anywhere) or block that port. Non-zero when there are none.
fw_find_rows() {
    local mode="$1" i
    FW_MATCH=()
    for i in "${!FW_ID[@]}"; do
        [[ -z "${4:-}" || "${FW_GROUP[$i]}" == "$4" ]] || continue
        if [[ "$mode" == allow ]]; then
            fw_act_allows "${FW_ACTION[$i]}" || continue
            fw_src_open "${FW_SRC[$i]}" || continue
        else
            fw_act_blocks "${FW_ACTION[$i]}" || continue
        fi
        fw_cover_has "${FW_COVER[$i]}" "$2" "$3" && FW_MATCH+=("$i")
    done
    ((${#FW_MATCH[@]} > 0))
}

fw_print_rules() {
    local i n
    n="${#FW_ID[@]}"
    if ((n == 0)); then
        info "No rules."
    else
        printf '%-6s %-9s %-6s %-22s %-20s %s\n' "ID" "ACTION" "PROTO" "PORT/SERVICE" "SOURCE" "RULE (as ${FW_BACKEND} reports it)"
        for i in "${!FW_ID[@]}"; do
            printf '%-6s %-9s %-6s %-22s %-20s %s\n' "${FW_ID[$i]}" "${FW_ACTION[$i]}" "${FW_PROTO[$i]}" \
                "${FW_PORT[$i]}" "${FW_SRC[$i]}" "${FW_RAW[$i]}"
        done
        info "${n} rule(s), in the order ${FW_BACKEND} reports them."
    fi
    for i in "${!FW_NOTES[@]}"; do
        info "${FW_NOTES[$i]}"
    done
}

fw_count_raw() { # fw_count_raw <raw>: how many listed rules read exactly like this one
    local i n=0
    for i in "${!FW_RAW[@]}"; do
        [[ "${FW_RAW[$i]}" == "$1" ]] && n=$((n + 1))
    done
    printf '%d' "$n"
}

fw_print_rows() { # fw_print_rows <indexes...>
    local i
    for i in "$@"; do
        printf '  ID %s: %s\n' "${FW_ID[$i]}" "${FW_RAW[$i]}"
    done
}

# --- ufw ---------------------------------------------------------------------------
# Documented commands: ufw status verbose / status numbered / app list / app info <profile>,
# ufw allow <port>/<proto>, ufw --force delete <number>.

fw_ufw_status() {
    local l
    FW_STATE="" FW_DEFAULT=""
    if ! fw_run ufw status verbose; then
        err "ufw status failed: ${FW_OUT}"
        return 1
    fi
    while IFS= read -r l; do
        case "$l" in
            "Status: active") FW_STATE=enabled ;;
            "Status: inactive") FW_STATE=disabled ;;
            "Default: "*) FW_DEFAULT="${l#Default: }" ;;
        esac
    done <<<"$FW_OUT"
    if [[ -z "$FW_STATE" ]]; then
        err "Could not read the ufw status from: ${FW_OUT}"
        return 1
    fi
    if [[ -z "$FW_DEFAULT" ]]; then
        FW_DEFAULT="not reported"
        [[ "$FW_STATE" == disabled ]] && FW_DEFAULT="not reported while ufw is inactive"
    fi
    return 0
}

fw_ufw_apps() { # the application profile names, from `ufw app list`
    local l
    FW_UFW_APPS=()
    fw_run ufw app list || return 0
    while IFS= read -r l; do
        [[ "$l" == "  "* ]] && FW_UFW_APPS+=("$(usr_trim "$l")")
    done <<<"$FW_OUT"
    return 0
}

fw_ufw_app_cover() { # fw_ufw_app_cover <profile>: its port tokens, from `ufw app info`
    local l inports=0 out=""
    fw_run ufw app info "$1" || return 0
    while IFS= read -r l; do
        if [[ "$l" == "Ports:" || "$l" == "Port:" ]]; then # ufw says "Port:" for a profile with one port
            inports=1
            continue
        fi
        if ((inports)); then
            l="$(usr_trim "$l")"
            [[ -z "$l" ]] && break
            out+="${out:+ }${l}"
        fi
    done <<<"$FW_OUT"
    printf '%s' "$out"
}

fw_in_list() { # fw_in_list <word> <list...>
    local w="$1" x
    shift
    for x in "$@"; do
        [[ "$x" == "$w" ]] && return 0
    done
    return 1
}

fw_ufw_load() {
    local l text rest to body act src t port proto cover re num app_cover
    fw_rules_clear
    if ! fw_run ufw status numbered; then
        err "ufw status failed: ${FW_OUT}"
        return 1
    fi
    text="$FW_OUT"
    FW_RULES_TEXT="$text"
    fw_ufw_apps
    re='^\[ *([0-9]+)\] (.*)$'
    while IFS= read -r l; do
        [[ "$l" =~ $re ]] || continue
        num="${BASH_REMATCH[1]}"
        rest="$(usr_trim "${BASH_REMATCH[2]}")"
        to="${rest%%  *}"
        body="$(usr_trim "${rest#"$to"}")"
        act="${body%%  *}"
        src="$(usr_trim "${body#"$act"}")"
        t="${to% (v6)}"
        port="-" proto="-" cover=""
        if [[ "$t" =~ ^([0-9][0-9,:]*)(/(tcp|udp))?$ ]]; then
            port="${BASH_REMATCH[1]}"
            proto="${BASH_REMATCH[3]:-any}"
            cover="${port}${BASH_REMATCH[3]:+/${BASH_REMATCH[3]}}"
        elif [[ "$t" != Anywhere* ]]; then
            port="$t" # an application profile (or a form ezvps does not split): shown as reported
            if fw_in_list "$t" "${FW_UFW_APPS[@]}"; then
                app_cover="$(fw_ufw_app_cover "$t")"
                cover="$app_cover"
                [[ -n "$app_cover" ]] && port="${t} (${app_cover})"
            fi
        fi
        fw_rule_add "$num" "${act,,}" "$proto" "$port" "${src:--}" "$(usr_trim "$rest")" "$num" "$cover" ""
    done <<<"$text"
    return 0
}

fw_ufw_add() { fw_run ufw allow "${1}/${2}"; }
fw_ufw_remove() { fw_run ufw --force delete "${FW_KEY[$1]}"; }

# --- firewalld ---------------------------------------------------------------------
# Documented commands: firewall-cmd --state, --get-default-zone, --get-active-zones,
# --zone=<z> --list-all / --list-ports / --list-services / --list-rich-rules / --list-sources,
# --info-service=<s>, --add-port / --remove-port / --remove-service / --remove-rich-rule
# (each run for the runtime config and again with --permanent). No --reload: it would drop
# unsaved runtime changes that are not ezvps's.

fw_firewalld_zones() { # FW_ZONE_DEFAULT, and FW_ZONES = the default zone first, then the other active zones
    local l z
    FW_ZONES=() FW_ZONE_DEFAULT=""
    if ! fw_run firewall-cmd --get-default-zone; then
        err "firewall-cmd --get-default-zone failed: ${FW_OUT}"
        return 1
    fi
    FW_ZONE_DEFAULT="$(usr_trim "$FW_OUT")"
    FW_ZONES=("$FW_ZONE_DEFAULT")
    if fw_run firewall-cmd --get-active-zones; then
        while IFS= read -r l; do
            [[ -n "$l" && "$l" != [[:space:]]* ]] || continue
            z="${l%% *}"
            fw_in_list "$z" "${FW_ZONES[@]}" || FW_ZONES+=("$z")
        done <<<"$FW_OUT"
    fi
    return 0
}

fw_firewalld_status() {
    local l t
    FW_STATE="" FW_DEFAULT=""
    if ! fw_run firewall-cmd --state; then
        FW_STATE=disabled
        FW_DEFAULT="not reported while firewalld is not running"
        return 0
    fi
    FW_STATE=enabled
    fw_firewalld_zones || return 1
    FW_DEFAULT="default zone ${FW_ZONE_DEFAULT}"
    if fw_run firewall-cmd "--zone=${FW_ZONE_DEFAULT}" --list-all; then
        while IFS= read -r l; do
            t="$(usr_trim "$l")"
            [[ "$t" == "target: "* ]] && FW_DEFAULT+=" (target: ${t#target: })"
        done <<<"$FW_OUT"
    fi
    return 0
}

fw_firewalld_load() {
    local z l t p toks items n=0 text="" cover raw action proto port src svc
    fw_rules_clear
    fw_firewalld_zones || return 1
    for z in "${FW_ZONES[@]}"; do
        text+="zone ${z}"$'\n'
        if ! fw_run firewall-cmd "--zone=${z}" --list-ports; then
            err "firewall-cmd --list-ports failed: ${FW_OUT}"
            return 1
        fi
        read -ra toks <<<"$FW_OUT"
        for p in "${toks[@]}"; do
            [[ "$p" =~ ^[0-9][0-9-]*/(tcp|udp|sctp|dccp)$ ]] || continue
            n=$((n + 1))
            text+="  port ${p}"$'\n'
            fw_rule_add "$n" allow "${p#*/}" "${p%%/*}" - "zone ${z}: port ${p}" "port|${z}|${p}" "${p//-/:}" "$z"
        done
        if ! fw_run firewall-cmd "--zone=${z}" --list-services; then
            err "firewall-cmd --list-services failed: ${FW_OUT}"
            return 1
        fi
        read -ra toks <<<"$FW_OUT"
        for svc in "${toks[@]}"; do
            cover=""
            if fw_run firewall-cmd "--info-service=${svc}"; then
                while IFS= read -r l; do
                    t="$(usr_trim "$l")"
                    [[ "$t" == "ports: "* ]] && cover="${t#ports: }"
                done <<<"$FW_OUT"
            fi
            n=$((n + 1))
            text+="  service ${svc}"$'\n'
            port="$svc"
            [[ -n "$cover" ]] && port="${svc} (${cover//-/:})"
            fw_rule_add "$n" allow - "$port" - "zone ${z}: service ${svc}" "service|${z}|${svc}" "${cover//-/:}" "$z"
        done
        if ! fw_run firewall-cmd "--zone=${z}" --list-rich-rules; then
            err "firewall-cmd --list-rich-rules failed: ${FW_OUT}"
            return 1
        fi
        while IFS= read -r raw; do
            [[ -n "$raw" ]] || continue
            raw="$(usr_trim "$raw")"
            action="-" proto="-" port="-" src="-" cover=""
            [[ "$raw" =~ (accept|reject|drop)$ ]] && action="${BASH_REMATCH[1]}"
            [[ "$raw" =~ source\ address=\"([^\"]+)\" ]] && src="${BASH_REMATCH[1]}"
            if [[ "$raw" =~ port\ port=\"([^\"]+)\"\ protocol=\"([a-z]+)\" ]]; then
                port="${BASH_REMATCH[1]}"
                proto="${BASH_REMATCH[2]}"
                cover="${port//-/:}/${proto}"
            elif [[ "$raw" =~ service\ name=\"([^\"]+)\" ]]; then
                port="${BASH_REMATCH[1]}"
            fi
            n=$((n + 1))
            text+="  rich ${raw}"$'\n'
            fw_rule_add "$n" "$action" "$proto" "$port" "$src" "zone ${z}: rich rule ${raw}" "rich|${z}|${raw}" "$cover" "$z"
        done <<<"$FW_OUT"
        if fw_run firewall-cmd "--zone=${z}" --list-sources && [[ -n "$(usr_trim "$FW_OUT")" ]]; then
            FW_NOTES+=("Zone ${z} applies only to these sources: $(usr_trim "$FW_OUT")")
        fi
    done
    FW_RULES_TEXT="$text"
    FW_NOTES+=("firewalld has no rule numbers: ID is the row number in this list. Ports, services and rich rules of the default and the active zones are shown.")
    return 0
}

# FW_KEY of a firewalld rule is "<type>|<zone>|<value>".
fw_firewalld_remove() {
    local key="${FW_KEY[$1]}" type zone value opt
    type="${key%%|*}"
    value="${key#*|}"
    zone="${value%%|*}"
    value="${value#*|}"
    case "$type" in
        port) opt="--remove-port=${value}" ;;
        service) opt="--remove-service=${value}" ;;
        rich) opt="--remove-rich-rule=${value}" ;;
        *)
            FW_OUT="unknown rule type"
            return 1
            ;;
    esac
    fw_run firewall-cmd "--zone=${zone}" "$opt" || return 1
    info "$FW_OUT"
    if ! fw_run firewall-cmd --permanent "--zone=${zone}" "$opt"; then
        FW_OUT="removed from the running firewall, but the permanent configuration could not be changed: ${FW_OUT}"
        FW_PARTIAL=1
    fi
    return 0
}

fw_firewalld_add() { # fw_firewalld_add <port> <proto>  (zone: FW_ADD_GROUP)
    fw_run firewall-cmd "--zone=${FW_ADD_GROUP}" "--add-port=${1}/${2}" || return 1
    info "$FW_OUT"
    if ! fw_run firewall-cmd --permanent "--zone=${FW_ADD_GROUP}" "--add-port=${1}/${2}"; then
        FW_OUT="added to the running firewall, but the permanent configuration could not be changed: ${FW_OUT}"
        FW_PARTIAL=1
    fi
    return 0
}

# --- nftables ----------------------------------------------------------------------
# Documented commands: nft -a list ruleset, nft insert rule <family> <table> <chain> <rule>,
# nft delete rule <family> <table> <chain> handle <handle>. Only chains of type filter hooked
# to input are read and changed, and only when they exist: ezvps never creates a table or chain.

# fw_nft_fields <rule text>: fills FW_P_*
fw_nft_fields() {
    local body="$1" toks tok ptxt re_port re_src re_icmp
    FW_P_ACTION="-" FW_P_PROTO="-" FW_P_PORT="-" FW_P_SRC="-" FW_P_COVER=""
    re_port='(tcp|udp|sctp|dccp) dport (\{[^}]*\}|[^ ]+)'
    re_src='(ip|ip6) saddr (\{[^}]*\}|[^ ]+)'
    re_icmp='(^| )(icmp|icmpv6) '
    read -ra toks <<<"$body"
    for tok in "${toks[@]}"; do
        case "$tok" in accept | drop | reject | queue | return | continue | jump | goto) FW_P_ACTION="$tok" ;; esac
    done
    if [[ "$body" =~ $re_port ]]; then
        FW_P_PROTO="${BASH_REMATCH[1]}"
        ptxt="${BASH_REMATCH[2]}"
        ptxt="${ptxt#\{}"
        ptxt="${ptxt%\}}"
        ptxt="${ptxt//[[:space:]]/}"
        FW_P_PORT="$ptxt"
        [[ "$ptxt" =~ ^[0-9][0-9,-]*$ ]] && FW_P_COVER="${ptxt//-/:}/${FW_P_PROTO}"
    elif [[ "$body" =~ $re_icmp ]]; then
        FW_P_PROTO="${BASH_REMATCH[2]}"
    fi
    if [[ "$body" =~ $re_src ]]; then
        ptxt="${BASH_REMATCH[2]}"
        ptxt="${ptxt#\{}"
        ptxt="${ptxt%\}}"
        FW_P_SRC="${ptxt//[[:space:]]/}"
    fi
    return 0
}

fw_nftables_load() {
    local l t fam="" tbl="" chain="" in_input=0 stack=() top n re_open re_table re_chain re_type re_rule body handle pol
    fw_rules_clear
    FW_NFT_CHAINS=() FW_NFT_POLICIES=()
    if ! fw_run nft -a list ruleset; then
        err "nft list ruleset failed: ${FW_OUT}"
        return 1
    fi
    FW_RULES_TEXT="$FW_OUT"
    re_open='^(table|chain|set|map|flowtable|counter|quota|limit|synproxy|ct)[ ].*\{( # handle [0-9]+)?$'
    re_table='^table ([a-z0-9]+) ([^ ]+) \{'
    re_chain='^chain ([^ ]+) \{'
    re_type='^type ([a-z]+) hook ([a-z]+) priority [^;]*;( policy ([a-z]+);)?'
    re_rule='^(.*[^ ]) # handle ([0-9]+)$'
    while IFS= read -r l; do
        t="$(usr_trim "$l")"
        [[ -n "$t" ]] || continue
        if [[ "$t" == "}" ]]; then
            n=${#stack[@]}
            if ((n > 0)); then
                [[ "${stack[$((n - 1))]}" == chain ]] && in_input=0
                unset "stack[$((n - 1))]"
                stack=("${stack[@]}")
            fi
            continue
        fi
        if [[ "$t" =~ $re_open ]]; then
            if [[ "$t" =~ $re_table ]]; then
                fam="${BASH_REMATCH[1]}"
                tbl="${BASH_REMATCH[2]}"
                stack+=(table)
            elif [[ "$t" =~ $re_chain ]]; then
                chain="${BASH_REMATCH[1]}"
                in_input=0
                stack+=(chain)
            else
                stack+=(other)
            fi
            continue
        fi
        n=${#stack[@]}
        ((n > 0)) || continue
        top="${stack[$((n - 1))]}"
        [[ "$top" == chain ]] || continue
        if [[ "$t" =~ $re_type ]]; then
            if [[ "${BASH_REMATCH[1]}" == filter && "${BASH_REMATCH[2]}" == input ]]; then
                in_input=1
                pol="${BASH_REMATCH[4]:-accept}"
                FW_NFT_CHAINS+=("${fam} ${tbl} ${chain}")
                FW_NFT_POLICIES+=("${pol}")
            fi
            continue
        fi
        ((in_input)) || continue
        [[ "$t" =~ $re_rule ]] || continue
        body="${BASH_REMATCH[1]}"
        handle="${BASH_REMATCH[2]}"
        fw_nft_fields "$body"
        fw_rule_add "$handle" "$FW_P_ACTION" "$FW_P_PROTO" "$FW_P_PORT" "$FW_P_SRC" "${fam} ${tbl} ${chain}: ${body}" \
            "${fam} ${tbl} ${chain} ${handle}" "$FW_P_COVER" "${fam} ${tbl} ${chain}"
    done <<<"$FW_RULES_TEXT"
    FW_NOTES+=("Showing the input chains (type filter, hook input) of the loaded nftables ruleset; ID is the nftables rule handle.")
    return 0
}

fw_nftables_status() {
    local i filtering=0
    FW_STATE="" FW_DEFAULT=""
    fw_nftables_load || return 1
    if ((${#FW_NFT_CHAINS[@]} == 0)); then
        FW_STATE=disabled
        FW_DEFAULT="not reported: no input filter chain is loaded"
        return 0
    fi
    ((${#FW_ID[@]} > 0)) && filtering=1
    for i in "${!FW_NFT_CHAINS[@]}"; do
        FW_DEFAULT+="${FW_DEFAULT:+; }${FW_NFT_CHAINS[$i]}: policy ${FW_NFT_POLICIES[$i]}"
        [[ "${FW_NFT_POLICIES[$i]}" != accept ]] && filtering=1
    done
    if ((filtering)); then FW_STATE=enabled; else FW_STATE=disabled; fi
    return 0
}

fw_nftables_add() { # fw_nftables_add <port> <proto>  (chain: FW_ADD_GROUP = "family table chain")
    local fam tbl chain
    read -r fam tbl chain <<<"$FW_ADD_GROUP"
    fw_run nft insert rule "$fam" "$tbl" "$chain" "$2" dport "$1" accept
}

fw_nftables_remove() { # fw_nftables_remove <index>
    local fam tbl chain handle
    read -r fam tbl chain handle <<<"${FW_KEY[$1]}"
    fw_run nft delete rule "$fam" "$tbl" "$chain" handle "$handle"
}

# --- iptables ----------------------------------------------------------------------
# Documented commands: iptables -w -S INPUT, iptables -w -I INPUT 1 -p <proto> --dport <port> -j ACCEPT,
# iptables -w -D INPUT <number>. The INPUT chain of the filter table, IPv4 only.

fw_iptables_load() {
    local l n=0 re_p re_dport re_s re_j t
    fw_rules_clear
    FW_IPT_POLICY=""
    if ! fw_run iptables -w -S INPUT; then
        err "iptables -S INPUT failed: ${FW_OUT}"
        return 1
    fi
    FW_RULES_TEXT="$FW_OUT"
    re_p=' -p ([a-z0-9]+)'
    re_dport=' --dports? ([0-9:,]+)'
    re_s=' -s ([^ ]+)'
    re_j=' -j ([^ ]+)'
    while IFS= read -r l; do
        case "$l" in
            "-P INPUT "*) FW_IPT_POLICY="${l#-P INPUT }" ;;
            "-A INPUT "*)
                n=$((n + 1))
                FW_P_ACTION="-" FW_P_PROTO="-" FW_P_PORT="-" FW_P_SRC="-" FW_P_COVER=""
                [[ "$l" =~ $re_p ]] && FW_P_PROTO="${BASH_REMATCH[1]}"
                if [[ "$l" =~ $re_dport ]]; then
                    FW_P_PORT="${BASH_REMATCH[1]}"
                    FW_P_COVER="${FW_P_PORT}"
                    [[ "$FW_P_PROTO" == tcp || "$FW_P_PROTO" == udp ]] && FW_P_COVER="${FW_P_PORT}/${FW_P_PROTO}"
                fi
                [[ "$l" =~ $re_s ]] && FW_P_SRC="${BASH_REMATCH[1]}"
                if [[ "$l" =~ $re_j ]]; then
                    t="${BASH_REMATCH[1]}"
                    case "$t" in ACCEPT | DROP | REJECT | RETURN) FW_P_ACTION="${t,,}" ;; *) FW_P_ACTION="$t" ;; esac
                fi
                fw_rule_add "$n" "$FW_P_ACTION" "$FW_P_PROTO" "$FW_P_PORT" "$FW_P_SRC" "$l" "$n" "$FW_P_COVER" "INPUT"
                ;;
        esac
    done <<<"$FW_RULES_TEXT"
    FW_NOTES+=("Showing the INPUT chain of the iptables filter table (IPv4 only); ID is the rule number in that chain.")
    return 0
}

fw_iptables_status() {
    FW_STATE="" FW_DEFAULT=""
    fw_iptables_load || return 1
    FW_DEFAULT="INPUT policy ${FW_IPT_POLICY:-not reported}"
    if [[ "$FW_IPT_POLICY" != ACCEPT || ${#FW_ID[@]} -gt 0 ]]; then
        FW_STATE=enabled
    else
        FW_STATE=disabled
    fi
    return 0
}

fw_iptables_add() { fw_run iptables -w -I INPUT 1 -p "$2" --dport "$1" -j ACCEPT; }
fw_iptables_remove() { fw_run iptables -w -D INPUT "${FW_KEY[$1]}"; }

# --- dispatch (literal names, so every function is visibly used) -------------------------

fw_status_load() {
    case "$FW_BACKEND" in
        ufw) fw_ufw_status ;;
        firewalld) fw_firewalld_status ;;
        nftables) fw_nftables_status ;;
        iptables) fw_iptables_status ;;
        *) return 1 ;;
    esac
}

fw_load() {
    case "$FW_BACKEND" in
        ufw) fw_ufw_load ;;
        firewalld) fw_firewalld_load ;;
        nftables) fw_nftables_load ;;
        iptables) fw_iptables_load ;;
        *) return 1 ;;
    esac
}

fw_do_add() { # fw_do_add <port> <proto>: 0 or 1; the output is in FW_OUT, FW_PARTIAL=1 for a half-done firewalld change
    FW_PARTIAL=0
    case "$FW_BACKEND" in
        ufw) fw_ufw_add "$1" "$2" || return 1 ;;
        firewalld) fw_firewalld_add "$1" "$2" || return 1 ;;
        nftables) fw_nftables_add "$1" "$2" || return 1 ;;
        iptables) fw_iptables_add "$1" "$2" || return 1 ;;
        *) return 1 ;;
    esac
    return 0
}

fw_do_remove() { # fw_do_remove <index>: 0 or 1, like fw_do_add
    FW_PARTIAL=0
    case "$FW_BACKEND" in
        ufw) fw_ufw_remove "$1" || return 1 ;;
        firewalld) fw_firewalld_remove "$1" || return 1 ;;
        nftables) fw_nftables_remove "$1" || return 1 ;;
        iptables) fw_iptables_remove "$1" || return 1 ;;
        *) return 1 ;;
    esac
    return 0
}

fw_add_preview() { # fw_add_preview <port> <proto>: the exact command(s) that will run
    case "$FW_BACKEND" in
        ufw) info "  ufw allow ${1}/${2}" ;;
        firewalld)
            info "  firewall-cmd --zone=${FW_ADD_GROUP} --add-port=${1}/${2}"
            info "  firewall-cmd --permanent --zone=${FW_ADD_GROUP} --add-port=${1}/${2}"
            ;;
        nftables) info "  nft insert rule ${FW_ADD_GROUP} ${2} dport ${1} accept" ;;
        iptables) info "  iptables -w -I INPUT 1 -p ${2} --dport ${1} -j ACCEPT" ;;
    esac
}

fw_remove_preview() { # fw_remove_preview <index>
    local i="$1" type zone value
    case "$FW_BACKEND" in
        ufw) info "  ufw --force delete ${FW_KEY[$i]}" ;;
        firewalld)
            type="${FW_KEY[$i]%%|*}"
            value="${FW_KEY[$i]#*|}"
            zone="${value%%|*}"
            value="${value#*|}"
            info "  firewall-cmd --zone=${zone} --remove-${type//rich/rich-rule}=${value}"
            info "  firewall-cmd --permanent --zone=${zone} --remove-${type//rich/rich-rule}=${value}"
            ;;
        nftables) info "  nft delete rule ${FW_KEY[$i]% *} handle ${FW_ID[$i]}" ;;
        iptables) info "  iptables -w -D INPUT ${FW_KEY[$i]}" ;;
    esac
}

# --- SSH protection ----------------------------------------------------------------------

fw_add_ssh_port() { # fw_add_ssh_port <port>: numeric and not there yet
    [[ "$1" =~ ^[0-9]+$ ]] || return 0
    fw_in_list "$1" "${FW_SSH_PORTS[@]}" || FW_SSH_PORTS+=("$1")
}

# FW_SSH_PORTS: the sshd ports (sshd -T, else the Port lines of sshd_config), plus the port of the
# SSH session this is running in (SSH_CONNECTION), else 22.
fw_ssh_ports() {
    local p l re
    FW_SSH_PORTS=()
    if have_cmd sshd && ssh_eff_load; then
        while IFS= read -r p; do
            fw_add_ssh_port "$p"
        done < <(ssh_eff_get port)
    fi
    if ((${#FW_SSH_PORTS[@]} == 0)) && [[ -r "$SSH_CONFIG_FILE" ]]; then
        re='^[[:space:]]*[Pp]ort[[:space:]]+([0-9]+)[[:space:]]*$'
        while IFS= read -r l; do
            [[ "$l" =~ $re ]] && fw_add_ssh_port "${BASH_REMATCH[1]}"
        done <"$SSH_CONFIG_FILE"
    fi
    re='^[^ ]+ [0-9]+ [^ ]+ ([0-9]+)$'
    [[ "${SSH_CONNECTION:-}" =~ $re ]] && fw_add_ssh_port "${BASH_REMATCH[1]}"
    ((${#FW_SSH_PORTS[@]} > 0)) || FW_SSH_PORTS=(22)
    return 0
}

# fw_rule_affects_ssh <index>: true (and FW_SSH_WHY says why) when removing this allow rule could
# cut SSH: it covers an SSH port, it is a service/profile named for SSH, or it has no port and no
# protocol restriction at all (so it may be what lets SSH or the current session through).
fw_rule_affects_ssh() {
    local i="$1" p name
    FW_SSH_WHY=""
    fw_act_allows "${FW_ACTION[$i]}" || return 1
    fw_ssh_ports
    if [[ -n "${FW_COVER[$i]}" ]]; then
        for p in "${FW_SSH_PORTS[@]}"; do
            if fw_cover_has "${FW_COVER[$i]}" "$p" tcp; then
                FW_SSH_WHY="allows SSH (port ${p}/tcp)"
                return 0
            fi
        done
        return 1
    fi
    name="${FW_PORT[$i]%% (*}"
    name="${name,,}"
    case "$name" in
        ssh | openssh | ssh-server)
            FW_SSH_WHY="is the SSH rule (SSH port ${FW_SSH_PORTS[*]})"
            return 0
            ;;
    esac
    if [[ "${FW_PORT[$i]}" == - && "${FW_PROTO[$i]}" == - ]]; then
        FW_SSH_WHY="has no port or protocol restriction, so it may be what keeps SSH (port ${FW_SSH_PORTS[*]}) or your current connection working"
        return 0
    fi
    return 1
}

# --- port in use ---------------------------------------------------------------------------

# fw_listeners <port> <proto>: FW_LISTENERS gets "<process> on <address>" per listener; when the
# check is not possible FW_LISTEN_NOTE says so.
fw_listeners() {
    local flag f l proc addr re
    FW_LISTENERS=() FW_LISTEN_NOTE=""
    if have_cmd ss; then
        if [[ "$2" == tcp ]]; then flag=-ltnp; else flag=-lunp; fi
        if ! fw_run ss -H "$flag" "( sport = :$1 )"; then
            FW_LISTEN_NOTE="ss failed, so ezvps could not check whether something listens on ${1}/${2}."
            return 0
        fi
        re='users:\(\("([^"]+)"'
        while IFS= read -r l; do
            [[ -n "$l" ]] || continue
            read -ra f <<<"$l"
            addr="${f[3]:-?}"
            proc="a process ezvps could not name"
            [[ "$l" =~ $re ]] && proc="${BASH_REMATCH[1]}"
            FW_LISTENERS+=("${proc} on ${addr}")
        done <<<"$FW_OUT"
        return 0
    fi
    if [[ "$2" == tcp ]]; then
        port_in_use "$1" && FW_LISTENERS+=("a process on port ${1} (the ss command is needed to name it)")
    else
        FW_LISTEN_NOTE="ss is not installed, so ezvps could not check whether something listens on ${1}/${2}."
    fi
    return 0
}

# --- common checks and records -------------------------------------------------------------

# Everything that must hold before ANY change: root, a supported system, a detected backend, and
# (ufw, firewalld) a firewall that is actually running, because a disabled one cannot report the
# rules back and ezvps never enables or disables a firewall.
fw_change_preflight() {
    require_root || return 1
    require_supported_os "Firewall" || return 1
    fw_need_backend || return 1
    fw_status_load || return 1
    if [[ "$FW_STATE" == disabled && ( "$FW_BACKEND" == ufw || "$FW_BACKEND" == firewalld ) ]]; then
        warn "${FW_BACKEND} is disabled. ezvps does not enable or disable a firewall, and a disabled ${FW_BACKEND} cannot report its rules back, so it will not change anything."
        info "Nothing was changed."
        return 1
    fi
    return 0
}

# A text copy of the rule listing the backend reported, for reference before a change.
fw_backup_rules() {
    local dest
    dest="${NGX_BACKUP_BASE}/firewall-${FW_BACKEND}.$(date +%Y%m%d-%H%M%S).$$"
    if ! { mkdir -p "$NGX_BACKUP_BASE" && chmod 700 "$NGX_BACKUP_BASE" && printf '%s\n' "$FW_RULES_TEXT" >"$dest" && chmod 600 "$dest"; }; then
        err "Could not save the current rules to ${dest}; stopping before any change."
        return 1
    fi
    info "Saved a text copy of the current rules to ${dest}"
    return 0
}

fw_persistence_note() {
    case "$FW_BACKEND" in
        nftables | iptables)
            info "Note: ${FW_BACKEND} changes apply to the running firewall only. ezvps does not rewrite your saved ${FW_BACKEND} configuration, so this change is lost at the next reboot or reload unless you save it with your usual method."
            ;;
    esac
}

# --- 1) Show firewall status -----------------------------------------------------------------

fw_show_status() {
    fw_need_backend || return 0
    fw_status_load || return 1
    info ""
    info "Status         : ${FW_STATE}"
    info "Default policy : ${FW_DEFAULT}"
    case "$FW_BACKEND" in
        nftables | iptables)
            info ""
            info "${FW_BACKEND} has no on/off switch: 'enabled' means a filtering chain with rules or a restrictive default policy is loaded."
            ;;
    esac
    return 0
}

# --- 2) List rules (read-only) ----------------------------------------------------------------

fw_list_rules() {
    fw_need_backend || return 0
    case "$FW_BACKEND" in
        ufw | firewalld)
            fw_status_load || return 1
            if [[ "$FW_STATE" == disabled ]]; then
                info "${FW_BACKEND} is disabled, and a disabled ${FW_BACKEND} does not report any rules."
                return 0
            fi
            ;;
    esac
    fw_load || return 1
    info ""
    fw_print_rules
    return 0
}

# --- 3) Allow port ------------------------------------------------------------------------------

# fw_ask_port_proto: sets FW_REQ_PORT and FW_REQ_PROTO; non-zero = cancelled or invalid (said so).
fw_ask_port_proto() {
    local p pr
    FW_REQ_PORT="" FW_REQ_PROTO=""
    if ! read -r -p "Port number to allow (1-65535, empty to cancel): " p; then
        info ""
        return 1
    fi
    p="$(usr_trim "$p")"
    if [[ -z "$p" ]]; then
        info "Cancelled. Nothing was changed."
        return 1
    fi
    if ! fw_valid_port "$p"; then
        err "Invalid port '$(fw_clean "$p")': use a single number from 1 to 65535 (digits only, no leading zero, no range or list). Nothing was changed."
        return 1
    fi
    if ! read -r -p "Protocol (tcp or udp): " pr; then
        info ""
        return 1
    fi
    if ! FW_REQ_PROTO="$(fw_norm_proto "$(usr_trim "$pr")")"; then
        err "Invalid protocol '$(fw_clean "$pr")': it must be tcp or udp. Nothing was changed."
        return 1
    fi
    FW_REQ_PORT="$p"
    return 0
}

# nftables only: choose the input chain to add to (never guessed when there is more than one).
fw_pick_nft_chain() {
    local i n="${#FW_NFT_CHAINS[@]}" ans
    if ((n == 0)); then
        err "No nftables input chain (type filter, hook input) is loaded, and ezvps does not create tables or chains. Nothing was changed."
        return 1
    fi
    if ((n == 1)); then
        FW_ADD_GROUP="${FW_NFT_CHAINS[0]}"
        return 0
    fi
    info "More than one nftables input chain is loaded:"
    for i in "${!FW_NFT_CHAINS[@]}"; do
        printf '%2d) %s (policy %s)\n' "$((i + 1))" "${FW_NFT_CHAINS[$i]}" "${FW_NFT_POLICIES[$i]}"
    done
    if ! read -r -p "Add the rule to which chain? (number, empty to cancel): " ans; then
        info ""
        return 1
    fi
    ans="$(usr_trim "$ans")"
    if [[ ! "$ans" =~ ^[0-9]+$ ]] || ((10#$ans < 1 || 10#$ans > n)); then
        info "No chain chosen. Nothing was changed."
        return 1
    fi
    FW_ADD_GROUP="${FW_NFT_CHAINS[$((10#$ans - 1))]}"
    return 0
}

fw_allow_port() {
    local port proto i question
    fw_change_preflight || return 1
    fw_ask_port_proto || return 0
    port="$FW_REQ_PORT"
    proto="$FW_REQ_PROTO"
    fw_load || return 1
    case "$FW_BACKEND" in
        nftables) fw_pick_nft_chain || return 0 ;;
        firewalld) FW_ADD_GROUP="$FW_ZONE_DEFAULT" ;;
        iptables) FW_ADD_GROUP="INPUT" ;;
        *) FW_ADD_GROUP="" ;;
    esac
    if fw_find_rows allow "$port" "$proto" "$FW_ADD_GROUP"; then
        warn "Port ${port}/${proto} is already allowed by:"
        fw_print_rows "${FW_MATCH[@]}"
        info "Nothing was changed."
        return 0
    fi
    if fw_find_rows block "$port" "$proto" "$FW_ADD_GROUP"; then
        warn "A rule that blocks ${port}/${proto} already exists. Rules are evaluated in the order ${FW_BACKEND} keeps them, so the new rule may not take effect:"
        fw_print_rows "${FW_MATCH[@]}"
    fi
    fw_listeners "$port" "$proto"
    question="Add this rule?"
    if ((${#FW_LISTENERS[@]} > 0)); then
        warn "${port}/${proto} is already in use on this server by:"
        for i in "${!FW_LISTENERS[@]}"; do
            info "  ${FW_LISTENERS[$i]}"
        done
        warn "Allowing it makes that service reachable according to its own listening address. Only continue if it is the service you mean to expose."
        question="Port ${port}/${proto} is already in use. Allow it anyway?"
    elif [[ -n "$FW_LISTEN_NOTE" ]]; then
        warn "$FW_LISTEN_NOTE"
    fi
    info ""
    info "Rule to add: allow ${port}/${proto} (${FW_BACKEND})"
    info "Command(s):"
    fw_add_preview "$port" "$proto"
    if ! ask_yes_no "$question"; then
        info "Cancelled. Nothing was changed."
        return 0
    fi
    fw_backup_rules || return 1
    if ! fw_do_add "$port" "$proto"; then
        err "${FW_BACKEND} could not add the rule: ${FW_OUT}"
        info "Nothing else was changed."
        return 1
    fi
    if ((FW_PARTIAL)); then
        warn "$FW_OUT"
    elif [[ -n "$FW_OUT" ]]; then
        info "$FW_OUT"
    fi
    info ""
    info "Rules now (re-read from ${FW_BACKEND}):"
    fw_load || return 1
    fw_print_rules
    if fw_find_rows allow "$port" "$proto" "$FW_ADD_GROUP"; then
        info ""
        info "The rule as ${FW_BACKEND} reports it:"
        fw_print_rows "${FW_MATCH[@]}"
    else
        warn "${FW_BACKEND} does not list an allow rule for ${port}/${proto} after the change. Check the list above."
        return 1
    fi
    fw_persistence_note
    return 0
}

# --- 4) Remove rule -------------------------------------------------------------------------------

fw_remove_rule() {
    local id i idx="" want_raw want_key before after
    fw_change_preflight || return 1
    fw_load || return 1
    info ""
    info "Current rules:"
    fw_print_rules
    if ((${#FW_ID[@]} == 0)); then
        info "There are no rules to remove."
        return 0
    fi
    info ""
    if ! read -r -p "ID of the rule to remove (empty to cancel): " id; then
        info ""
        return 0
    fi
    id="$(usr_trim "$id")"
    if [[ -z "$id" ]]; then
        info "Cancelled. Nothing was changed."
        return 0
    fi
    for i in "${!FW_ID[@]}"; do
        [[ "${FW_ID[$i]}" == "$id" ]] && idx="$i"
    done
    if [[ ! "$id" =~ ^[0-9]+$ || -z "$idx" ]]; then
        err "There is no rule with ID '$(fw_clean "$id")' in the list. Nothing was changed."
        return 0
    fi
    want_raw="${FW_RAW[$idx]}"
    want_key="${FW_KEY[$idx]}"
    before="$(fw_count_raw "$want_raw")"
    info ""
    info "Rule to remove (only this one):"
    fw_print_rows "$idx"
    info "Command(s):"
    fw_remove_preview "$idx"
    if ! ask_yes_no "Remove rule ${id}? The firewall stays enabled and every other rule stays as it is."; then
        info "Cancelled. Nothing was changed."
        return 0
    fi
    if fw_rule_affects_ssh "$idx"; then
        warn "WARNING: rule ${id} ${FW_SSH_WHY}."
        warn "Removing it can lock you out of this server, including the session you are using now, and ezvps cannot undo that remotely."
        [[ -n "${SSH_CONNECTION:-}" ]] && warn "You appear to be connected over SSH right now."
        if ! ask_yes_no "Remove this SSH-related rule anyway?"; then
            info "Cancelled. Nothing was changed."
            return 0
        fi
    fi
    # The numbers can shift between listing and removing (ufw, iptables, firewalld): re-read first.
    fw_load || return 1
    idx=""
    for i in "${!FW_ID[@]}"; do
        [[ "${FW_ID[$i]}" == "$id" && "${FW_KEY[$i]}" == "$want_key" && "${FW_RAW[$i]}" == "$want_raw" ]] && idx="$i"
    done
    if [[ -z "$idx" ]]; then
        err "The rules changed while you were choosing (rule ${id} is no longer the same). Nothing was changed; list the rules again."
        return 1
    fi
    fw_backup_rules || return 1
    if ! fw_do_remove "$idx"; then
        err "${FW_BACKEND} could not remove the rule: ${FW_OUT}"
        info "Nothing else was changed."
        return 1
    fi
    if ((FW_PARTIAL)); then
        warn "$FW_OUT"
    elif [[ -n "$FW_OUT" ]]; then
        info "$FW_OUT"
    fi
    info ""
    info "Rules now (re-read from ${FW_BACKEND}):"
    fw_load || return 1
    fw_print_rules
    after="$(fw_count_raw "$want_raw")"
    if ((after >= before)); then
        warn "${FW_BACKEND} still lists the rule you removed. Check the list above."
        return 1
    fi
    info ""
    info "Removed: ${want_raw}"
    info "Only that rule was removed; the firewall was not disabled."
    fw_persistence_note
    return 0
}

# --- submenu ------------------------------------------------------------------------------------------

FW_MENU_LABELS=("Show firewall status" "List rules" "Allow port" "Remove rule")

module_firewall() {
    local choice i
    # Detect first: with no backend there is nothing to show or change, so say so and go back.
    if ! fw_detect; then
        info ""
        warn "No firewall backend found (looked for, in this order: ufw, firewalld, nftables, iptables)."
        info "ezvps does not install a firewall tool. Nothing was changed."
        return 0
    fi
    while true; do
        info ""
        info "${C_BOLD}Firewall${C_RESET}"
        info "Backend: ${FW_BACKEND}"
        info ""
        for i in "${!FW_MENU_LABELS[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${FW_MENU_LABELS[$i]}"
        done
        printf '%2d) %s\n' 0 "Back"
        info ""
        if ! read -r -p "Select: " choice; then
            info ""
            return 0
        fi
        choice="${choice//[[:space:]]/}"
        case "$choice" in
            0) return 0 ;;
            1) fw_show_status || true ;;
            2) fw_list_rules || true ;;
            3) fw_allow_port || true ;;
            4) fw_remove_rule || true ;;
            *)
                warn "Invalid choice: $(fw_clean "${choice:-<empty>}")"
                ;;
        esac
        pause "Press Enter to continue... " || true
    done
}

# ---------------------------------------------------------------------------
# Backup, Check For Updates and Uninstall (ezvps itself; PR 12)
#
# These three items manage ezvps and nothing else. They never install, update
# or remove nginx, 3x-ui, Backpack, ctunnel, Lazyports, ezl2tp, users or any
# tool's own config. A backup is a directory
#   /var/backups/ezvps/ezvps-backup.<UTC timestamp>-<NN>/   (mode 700)
# holding a MANIFEST and some of:
#   bin/ezvps       the ezvps script
#   state/          the ezvps state files (/var/lib/ezvps)
#   nginx-sites/    ezvps-made sites from nginx conf.d        (full backups)
#   certs/          the certificate store /etc/ssl/ezvps      (full backups)
# Every result is verified on the file system (byte compare, modes), never
# taken from the success of the copy alone.
# ---------------------------------------------------------------------------

EZB_BACKUP_BASE="${EZVPS_BACKUP_DIR:-/var/backups/ezvps}"
EZB_STATE_DIR="${EZVPS_STATE_DIR:-/var/lib/ezvps}"
EZB_BIN="${EZVPS_BIN_DIR:-/usr/local/bin}/ezvps"
EZB_INSTALL_STATE="${EZB_STATE_DIR}/install.state"
EZB_PREFIX="ezvps-backup"
EZB_UPDATE_BRANCH="main"
EZB_NAME_RE='^ezvps-backup\.[0-9]{8}-[0-9]{6}-[0-9]{2}$'

EZB_LAST_PATH="" EZB_UNINSTALLED=0
EZB_L_DIRS=() EZB_L_SKIPPED=0
EZB_SITES=() EZB_NEW=()
EZB_V_SCRIPT=0 EZB_V_STATE=() EZB_V_SITES=() EZB_V_CERTS=()
UPD_INST_VERSION="" UPD_INST_COMMIT="" UPD_INST_WHY="" UPD_SOURCE=""
UPD_LATEST_VERSION="" UPD_LATEST_COMMIT="" UPD_VERIFY_VERSION="" UPD_VERIFY_OUT=""
UPD_TMP=""

# --- checks that come before any of the three items --------------------------

# The backup directory exists, is mode 700 and can be written to.
ezb_backup_dir_ready() {
    local probe
    if ! { mkdir -p -- "$EZB_BACKUP_BASE" && chmod 700 -- "$EZB_BACKUP_BASE"; } 2>/dev/null; then
        err "The backup directory ${EZB_BACKUP_BASE} cannot be created or set to mode 700. Nothing was changed."
        return 1
    fi
    if ! probe="$(mktemp "${EZB_BACKUP_BASE}/.probe.XXXXXX" 2>/dev/null)"; then
        err "The backup directory ${EZB_BACKUP_BASE} is not writable. Nothing was changed."
        return 1
    fi
    rm -f -- "$probe"
    return 0
}

# ezb_preflight <action> <read|write>: root, a supported system and, for anything
# that writes, a writable backup directory. Read-only actions (list, check) must
# not create the backup directory.
ezb_preflight() {
    require_root || return 1
    require_supported_os "$1" || return 1
    require_cmds cp mkdir mv rm rmdir mktemp date chmod cmp stat du || return 1
    [[ "${2:-read}" == "write" ]] || return 0
    ezb_backup_dir_ready
}

# --- small helpers -----------------------------------------------------------

ezb_fmt_size() { # ezb_fmt_size <bytes>
    local b="$1" t
    if ((b < 1024)); then
        printf '%d B' "$b"
    elif ((b < 1048576)); then
        t=$((b * 10 / 1024))
        printf '%d.%d KiB' "$((t / 10))" "$((t % 10))"
    else
        t=$((b * 10 / 1048576))
        printf '%d.%d MiB' "$((t / 10))" "$((t % 10))"
    fi
}

ezb_plural() { # ezb_plural <n> <singular> [plural]
    if (($1 == 1)); then printf '%d %s' "$1" "$2"; else printf '%d %s' "$1" "${3:-${2}s}"; fi
}

# ezb_count_files <dir>: regular files below it (recursive), dotfiles included.
ezb_count_files() {
    local e n=0 sub
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [[ -e "$e" || -L "$e" ]] || continue
        if [[ -d "$e" && ! -L "$e" ]]; then
            sub="$(ezb_count_files "$e")"
            n=$((n + sub))
        elif [[ -f "$e" ]]; then
            n=$((n + 1))
        fi
    done
    printf '%d' "$n"
}

# ezb_same_tree <src> <dst>: everything below src exists below dst, files byte for byte.
ezb_same_tree() {
    local e rel
    for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [[ -e "$e" || -L "$e" ]] || continue
        rel="${e##*/}"
        if [[ -L "$e" ]]; then
            [[ -L "$2/$rel" ]] || return 1
        elif [[ -d "$e" ]]; then
            [[ -d "$2/$rel" ]] || return 1
            ezb_same_tree "$e" "$2/$rel" || return 1
        else
            [[ -f "$2/$rel" ]] || return 1
            cmp -s -- "$e" "$2/$rel" || return 1
        fi
    done
    return 0
}

# ezb_put_file <src> <dst>: temp file next to the target + mv (atomic), mode and
# owner kept. A target that did not exist is remembered in EZB_NEW for a rollback.
ezb_put_file() {
    local tmp
    [[ -e "$2" || -L "$2" ]] || EZB_NEW+=("$2")
    tmp="$(mktemp "${2%/*}/.ezb.XXXXXX")" || return 1
    if cp -p -- "$1" "$tmp" && mv -f -- "$tmp" "$2"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# An ezvps-made nginx site: a regular file named <domain>.conf that carries the ezvps
# marker for that same domain. Hand-written files are never read as ezvps's.
ezb_site_managed() {
    [[ -f "$1" && ! -L "$1" ]] || return 1
    ngx_read_site "$1" || return 1
    ((NGX_SITE_MANAGED == 1)) || return 1
    ngx_valid_domain "$NGX_SITE_DOMAIN" || return 1
    [[ "${1##*/}" == "${NGX_SITE_DOMAIN}.conf" ]]
}

ezb_find_sites() { # fills EZB_SITES with the paths of the ezvps-made sites in conf.d
    local f
    EZB_SITES=()
    [[ -d "$NGX_CONFD" ]] || return 0
    for f in "$NGX_CONFD"/*.conf; do
        [[ -e "$f" || -L "$f" ]] || continue
        ezb_site_managed "$f" && EZB_SITES+=("$f")
    done
    return 0
}

# --- what is installed, and from where ---------------------------------------

# install.state: written by install.sh and by Update ezvps (plain key=value,
# read without sourcing): version, commit, source, sha256, installed.
upd_state_get() { # upd_state_get <key>
    local k v
    [[ -r "$EZB_INSTALL_STATE" ]] || return 0
    while IFS='=' read -r k v; do
        if [[ "$k" == "$1" ]]; then
            printf '%s' "$v"
            return 0
        fi
    done <"$EZB_INSTALL_STATE"
    return 0
}

upd_file_version() { # upd_file_version <script>: its EZVPS_VERSION, read as text (never executed)
    local line v
    [[ -r "$1" ]] || return 0
    while IFS= read -r line; do
        if [[ "$line" =~ ^EZVPS_VERSION=\"([A-Za-z0-9._+-]+)\"$ ]]; then
            v="${BASH_REMATCH[1]}"
            printf '%s' "$v"
            return 0
        fi
    done <"$1"
    return 0
}

# The installed version comes from the installed file. The commit is trusted only when
# install.state records one AND the installed file still has the recorded sha256;
# otherwise it is unknown, never guessed.
upd_installed_info() {
    local sha st_commit st_sha
    UPD_INST_VERSION="" UPD_INST_COMMIT="" UPD_INST_WHY="" UPD_SOURCE="$(upd_state_get source)"
    if [[ -f "$EZB_BIN" ]]; then
        UPD_INST_VERSION="$(upd_file_version "$EZB_BIN")"
    fi
    st_commit="$(upd_state_get commit)"
    st_sha="$(upd_state_get sha256)"
    if [[ ! -f "$EZB_BIN" ]]; then
        UPD_INST_WHY="ezvps is not installed at ${EZB_BIN}"
    elif [[ ! -f "$EZB_INSTALL_STATE" ]]; then
        UPD_INST_WHY="no install record in ${EZB_STATE_DIR}: this ezvps was installed before versions were recorded"
    elif [[ ! "$st_commit" =~ ^[0-9a-f]{40}$ ]]; then
        UPD_INST_WHY="the install record has no commit (installed from a copy that is not a git checkout, or an unclean one)"
    elif [[ ! "$st_sha" =~ ^[0-9a-f]{64}$ ]] || ! have_cmd sha256sum; then
        UPD_INST_WHY="the install record cannot be checked against the installed script"
    else
        sha="$(sha256sum "$EZB_BIN" 2>/dev/null)"
        sha="${sha%% *}"
        if [[ "$sha" != "$st_sha" ]]; then
            UPD_INST_WHY="the installed script differs from the one the install record describes"
        else
            UPD_INST_COMMIT="$st_commit"
        fi
    fi
    return 0
}

# --- backup: create ----------------------------------------------------------

# A fresh mode-700 directory ezvps-backup.<UTC time>-<NN> (NN counts backups made in the same second).
ezb_new_dir() {
    local stamp n=1 d
    EZB_LAST_PATH=""
    stamp="$(date -u +%Y%m%d-%H%M%S)"
    while ((n <= 99)); do
        printf -v d '%s/%s.%s-%02d' "$EZB_BACKUP_BASE" "$EZB_PREFIX" "$stamp" "$n"
        if mkdir -m 700 -- "$d" 2>/dev/null; then
            EZB_LAST_PATH="$d"
            return 0
        fi
        n=$((n + 1))
    done
    return 1
}

# ezb_fill <dir> <reason> <full|core>: copy and verify. Sets EZB_C_SCRIPT, EZB_C_STATE,
# EZB_C_SITES (names), EZB_C_CERTS (domains).
EZB_C_SCRIPT=0 EZB_C_STATE=0 EZB_C_SITES=() EZB_C_CERTS=()
ezb_fill() {
    local d="$1" reason="$2" scope="$3" f e name mode
    EZB_C_SCRIPT=0 EZB_C_STATE=0 EZB_C_SITES=() EZB_C_CERTS=()
    if [[ -f "$EZB_BIN" ]]; then
        mkdir -m 700 -- "$d/bin" && cp -p -- "$EZB_BIN" "$d/bin/ezvps" || return 1
        cmp -s -- "$EZB_BIN" "$d/bin/ezvps" || return 1
        EZB_C_SCRIPT=1
    fi
    if [[ -d "$EZB_STATE_DIR" ]]; then
        EZB_C_STATE="$(ezb_count_files "$EZB_STATE_DIR")"
        if ((EZB_C_STATE > 0)); then
            mkdir -m 700 -- "$d/state" && cp -a -- "$EZB_STATE_DIR/." "$d/state/" && chmod 700 -- "$d/state" || return 1
            ezb_same_tree "$EZB_STATE_DIR" "$d/state" || return 1
        fi
    fi
    if [[ "$scope" == "full" ]]; then
        ezb_find_sites
        if ((${#EZB_SITES[@]} > 0)); then
            mkdir -m 700 -- "$d/nginx-sites" || return 1
            for f in "${EZB_SITES[@]}"; do
                name="${f##*/}"
                cp -p -- "$f" "$d/nginx-sites/$name" || return 1
                cmp -s -- "$f" "$d/nginx-sites/$name" || return 1
                EZB_C_SITES+=("$name")
            done
        fi
        if [[ -d "$CERT_DIR" && ! -L "$CERT_DIR" ]] && (($(ezb_count_files "$CERT_DIR") > 0)); then
            mkdir -m 700 -- "$d/certs" && cp -a -- "$CERT_DIR/." "$d/certs/" || return 1
            chmod 700 -- "$d/certs" || return 1
            ezb_same_tree "$CERT_DIR" "$d/certs" || return 1
            for e in "$d/certs"/*; do
                [[ -d "$e" && ! -L "$e" ]] && EZB_C_CERTS+=("${e##*/}")
            done
        fi
    fi
    upd_installed_info
    {
        printf 'format=1\n'
        printf 'created=%s\n' "${d##*/"${EZB_PREFIX}".}"
        printf 'reason=%s\n' "$reason"
        printf 'scope=%s\n' "$scope"
        printf 'ezvps_version=%s\n' "${UPD_INST_VERSION:-unknown}"
        printf 'ezvps_commit=%s\n' "${UPD_INST_COMMIT:-unknown}"
    } >"$d/MANIFEST" || return 1
    chmod 600 -- "$d/MANIFEST" || return 1
    mode="$(stat -c %a -- "$d" 2>/dev/null)"
    [[ "$mode" == "700" ]] || return 1
    return 0
}

# ezb_create <reason> <full|core>: a verified backup of the current state. Sets
# EZB_LAST_PATH. Prints what went in. Non-zero (and a message) when anything failed,
# in which case this run's own incomplete directory is removed and nothing else is.
ezb_create() {
    local d s
    ezb_backup_dir_ready || return 1
    if ! ezb_new_dir; then
        err "Cannot create a new backup directory in ${EZB_BACKUP_BASE}."
        return 1
    fi
    d="$EZB_LAST_PATH"
    if ! ezb_fill "$d" "$1" "$2"; then
        err "The backup to ${d} could not be completed and verified; it was discarded. Nothing was changed."
        rm -rf -- "$d"
        EZB_LAST_PATH=""
        return 1
    fi
    info "Backup created and verified: ${d}"
    info "Included:"
    if ((EZB_C_SCRIPT == 1)); then info "  ezvps script:   ${EZB_BIN}"; else info "  ezvps script:   not present at ${EZB_BIN}"; fi
    if ((EZB_C_STATE > 0)); then
        info "  ezvps state:    $(ezb_plural "$EZB_C_STATE" file) from ${EZB_STATE_DIR}"
    else
        info "  ezvps state:    none found in ${EZB_STATE_DIR}"
    fi
    if [[ "$2" == "full" ]]; then
        if ((${#EZB_C_SITES[@]} > 0)); then
            info "  nginx sites:    $(ezb_plural "${#EZB_C_SITES[@]}" "ezvps-made site") from ${NGX_CONFD}: ${EZB_C_SITES[*]}"
        else
            info "  nginx sites:    no ezvps-made sites in ${NGX_CONFD}"
        fi
        if ((${#EZB_C_CERTS[@]} > 0)); then
            s="$(ezb_plural "${#EZB_C_CERTS[@]}" "domain")"
            info "  certificates:   ${s} from ${CERT_DIR}: ${EZB_C_CERTS[*]} (private keys are copied, never printed)"
        else
            info "  certificates:   none in ${CERT_DIR}"
        fi
    else
        info "  (nginx sites and certificates are not part of this backup: this action does not change them)"
    fi
    info "The backup directory is mode 700 and ezvps never deletes backups."
    return 0
}

ezb_create_cmd() {
    ezb_preflight "Create backup" write || return 0
    info ""
    info "ezvps will back up its own files to ${EZB_BACKUP_BASE}/ (mode 700):"
    info "  the ezvps script (${EZB_BIN}), the ezvps state files (${EZB_STATE_DIR}),"
    info "  the ezvps-made nginx sites (${NGX_CONFD}) and the certificates (${CERT_DIR}) if present."
    info "Other tools' own config (3x-ui, Backpack, ...), users and SSH settings are not included."
    info ""
    ezb_create manual full || true
    return 0
}

# --- backup: list ------------------------------------------------------------

# ezb_load_list: EZB_L_DIRS = the backups ezvps made (valid name, directory, MANIFEST), newest first.
ezb_load_list() {
    local LC_ALL=C e name i j tmp
    EZB_L_DIRS=() EZB_L_SKIPPED=0
    [[ -d "$EZB_BACKUP_BASE" ]] || return 0
    for e in "$EZB_BACKUP_BASE"/"${EZB_PREFIX}".*; do
        [[ -e "$e" || -L "$e" ]] || continue
        name="${e##*/}"
        if [[ -d "$e" && ! -L "$e" && "$name" =~ $EZB_NAME_RE && -f "$e/MANIFEST" && ! -L "$e/MANIFEST" ]]; then
            EZB_L_DIRS+=("$e")
        else
            EZB_L_SKIPPED=$((EZB_L_SKIPPED + 1))
        fi
    done
    for ((i = 1; i < ${#EZB_L_DIRS[@]}; i++)); do
        tmp="${EZB_L_DIRS[$i]}"
        j=$((i - 1))
        while ((j >= 0)) && [[ "${EZB_L_DIRS[$j]}" < "$tmp" ]]; do
            EZB_L_DIRS[j + 1]="${EZB_L_DIRS[$j]}"
            j=$((j - 1))
        done
        EZB_L_DIRS[j + 1]="$tmp"
    done
    return 0
}

ezb_manifest_get() { # ezb_manifest_get <dir> <key>
    local k v
    while IFS='=' read -r k v; do
        if [[ "$k" == "$2" ]]; then
            printf '%s' "${v//[^A-Za-z0-9._+ -]/}"
            return 0
        fi
    done <"$1/MANIFEST"
    return 0
}

ezb_contents_summary() { # ezb_contents_summary <dir>: what is really inside, counted on disk
    local parts="" n e
    [[ -f "$1/bin/ezvps" ]] && parts="script"
    n=0
    [[ -d "$1/state" ]] && n="$(ezb_count_files "$1/state")"
    ((n > 0)) && parts+="${parts:+, }$(ezb_plural "$n" "state file")"
    n=0
    for e in "$1/nginx-sites"/*.conf; do [[ -f "$e" ]] && n=$((n + 1)); done
    ((n > 0)) && parts+="${parts:+, }$(ezb_plural "$n" "nginx site")"
    n=0
    for e in "$1/certs"/*; do [[ -d "$e" ]] && n=$((n + 1)); done
    ((n > 0)) && parts+="${parts:+, }$(ezb_plural "$n" "certificate domain")"
    printf '%s' "${parts:-nothing}"
}

ezb_print_list() {
    local i d name ts size reason summary parts
    info "ezvps backups in ${EZB_BACKUP_BASE} (newest first, times are UTC):"
    for i in "${!EZB_L_DIRS[@]}"; do
        d="${EZB_L_DIRS[$i]}"
        name="${d##*/}"
        ts="${name#"${EZB_PREFIX}".}"
        ts="${ts:0:4}-${ts:4:2}-${ts:6:2} ${ts:9:2}:${ts:11:2}:${ts:13:2}"
        size="$(du -sb -- "$d" 2>/dev/null)"
        size="$(ezb_fmt_size "${size%%[[:space:]]*}")"
        reason="$(ezb_manifest_get "$d" reason)"
        summary="$(ezb_contents_summary "$d")"
        printf '%2d) %s  %10s  %-12s  %s\n' "$((i + 1))" "$ts" "$size" "${reason:-unknown}" "$summary"
        info "      ${d}"
    done
    if ((EZB_L_SKIPPED > 0)); then
        info "(Not listed: $(ezb_plural "$EZB_L_SKIPPED" entry entries) named ${EZB_PREFIX}.* that are incomplete or unrecognised.)"
    fi
    return 0
}

ezb_list_cmd() {
    ezb_preflight "List backups" read || return 0
    ezb_load_list
    info ""
    if ((${#EZB_L_DIRS[@]} == 0)); then
        info "No ezvps backups found in ${EZB_BACKUP_BASE}."
        if ((EZB_L_SKIPPED > 0)); then
            info "(Not listed: $(ezb_plural "$EZB_L_SKIPPED" entry entries) named ${EZB_PREFIX}.* that are incomplete or unrecognised.)"
        fi
    else
        ezb_print_list
    fi
    info "Backups made by other ezvps modules (x-ui.*, nginx-*, ...) are not listed here."
    return 0
}

# --- backup: restore ---------------------------------------------------------

# ezb_validate_backup <dir>: refuses a backup with anything unexpected in it, before
# anything is changed. Fills EZB_V_*.
ezb_validate_backup() {
    local d="$1" e name f bad=0 out
    EZB_V_SCRIPT=0 EZB_V_STATE=() EZB_V_SITES=() EZB_V_CERTS=()
    if [[ "$(ezb_manifest_get "$d" format)" != "1" ]]; then
        err "${d}: unknown backup format."
        return 1
    fi
    if [[ -e "$d/bin" || -L "$d/bin" ]]; then
        if [[ -d "$d/bin" && ! -L "$d/bin" && -f "$d/bin/ezvps" && ! -L "$d/bin/ezvps" ]]; then
            if ! out="$(bash -n "$d/bin/ezvps" 2>&1)"; then
                err "The ezvps script in this backup has a syntax error; it will not be restored: ${out%%$'\n'*}"
                bad=1
            else
                out="$(EZVPS_ALLOW_NONROOT=1 bash "$d/bin/ezvps" --version </dev/null 2>&1)"
                if [[ "$out" =~ ^ezvps\ [A-Za-z0-9._+-]+$ ]]; then
                    EZB_V_SCRIPT=1
                else
                    err "The ezvps script in this backup does not report a version; it will not be restored."
                    bad=1
                fi
            fi
        else
            err "Unexpected entry bin in this backup."
            bad=1
        fi
    fi
    if [[ -e "$d/state" || -L "$d/state" ]]; then
        if [[ -d "$d/state" && ! -L "$d/state" ]]; then
            for e in "$d/state"/* "$d/state"/.[!.]*; do
                [[ -e "$e" || -L "$e" ]] || continue
                name="${e##*/}"
                if [[ -f "$e" && ! -L "$e" && "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
                    EZB_V_STATE+=("$name")
                else
                    err "Unexpected entry in the state part of this backup."
                    bad=1
                fi
            done
        else
            err "Unexpected entry state in this backup."
            bad=1
        fi
    fi
    if [[ -e "$d/nginx-sites" || -L "$d/nginx-sites" ]]; then
        if [[ -d "$d/nginx-sites" && ! -L "$d/nginx-sites" ]]; then
            for e in "$d/nginx-sites"/* "$d/nginx-sites"/.[!.]*; do
                [[ -e "$e" || -L "$e" ]] || continue
                if ezb_site_managed "$e"; then
                    EZB_V_SITES+=("${e##*/}")
                else
                    err "Unexpected entry in the nginx sites part of this backup (not an ezvps-made <domain>.conf)."
                    bad=1
                fi
            done
        else
            err "Unexpected entry nginx-sites in this backup."
            bad=1
        fi
    fi
    if [[ -e "$d/certs" || -L "$d/certs" ]]; then
        if [[ -d "$d/certs" && ! -L "$d/certs" ]]; then
            for e in "$d/certs"/* "$d/certs"/.[!.]*; do
                [[ -e "$e" || -L "$e" ]] || continue
                name="${e##*/}"
                if [[ -d "$e" && ! -L "$e" ]] && ngx_valid_domain "$name"; then
                    for f in "$e"/* "$e"/.[!.]*; do
                        [[ -e "$f" || -L "$f" ]] || continue
                        if [[ ! -f "$f" || -L "$f" || ! "${f##*/}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
                            err "Unexpected entry in the certificate part of this backup."
                            bad=1
                        fi
                    done
                    EZB_V_CERTS+=("$name")
                else
                    err "Unexpected entry in the certificate part of this backup (not a <domain> directory)."
                    bad=1
                fi
            done
        else
            err "Unexpected entry certs in this backup."
            bad=1
        fi
    fi
    ((bad == 0))
}

# Newly created paths are removed again, deepest first (directories only when empty).
ezb_undo_new() {
    local i p
    for ((i = ${#EZB_NEW[@]} - 1; i >= 0; i--)); do
        p="${EZB_NEW[$i]}"
        if [[ -d "$p" && ! -L "$p" ]]; then
            rmdir -- "$p" 2>/dev/null
        else
            rm -f -- "$p"
        fi
    done
    EZB_NEW=()
    return 0
}

# ezb_apply_certs <backup dir>: certs/<domain>/<file> into the store (dirs 700, privkey.pem 600).
EZB_A_CERT_FILES=0
ezb_apply_certs() {
    local src="$1/certs" dom f dest rc=0
    EZB_A_CERT_FILES=0
    [[ -d "$src" ]] || return 0
    if [[ ! -d "$CERT_DIR" ]]; then
        mkdir -p -- "$CERT_DIR" || return 1
        EZB_NEW+=("$CERT_DIR")
        chmod 700 -- "$CERT_DIR" || return 1
    fi
    for dom in "$src"/*; do
        [[ -d "$dom" ]] || continue
        dest="$CERT_DIR/${dom##*/}"
        if [[ ! -d "$dest" ]]; then
            mkdir -m 700 -- "$dest" || return 1
            EZB_NEW+=("$dest")
        fi
        for f in "$dom"/*; do
            [[ -f "$f" ]] || continue
            if ezb_put_file "$f" "$dest/${f##*/}"; then
                [[ "${f##*/}" == "privkey.pem" ]] && chmod 600 -- "$dest/${f##*/}"
                EZB_A_CERT_FILES=$((EZB_A_CERT_FILES + 1))
            else
                err "Could not restore ${dest}/${f##*/}."
                rc=1
            fi
        done
    done
    return "$rc"
}

# ezb_apply_sites <backup dir> <names...>: into conf.d. A hand-written file or a symlink
# with the same name is never overwritten. EZB_A_SITES / EZB_A_SKIPPED list the outcome.
EZB_A_SITES=() EZB_A_SKIPPED=()
ezb_apply_sites() {
    local src="$1/nginx-sites" name rc=0
    shift
    EZB_A_SITES=() EZB_A_SKIPPED=()
    for name in "$@"; do
        if [[ -e "$NGX_CONFD/$name" || -L "$NGX_CONFD/$name" ]] && ! ezb_site_managed "$NGX_CONFD/$name"; then
            warn "${NGX_CONFD}/${name} exists and was not made by ezvps; it is not overwritten."
            EZB_A_SKIPPED+=("$name")
            continue
        fi
        if ezb_put_file "$src/$name" "$NGX_CONFD/$name"; then
            EZB_A_SITES+=("$name")
        else
            err "Could not restore ${NGX_CONFD}/${name}."
            rc=1
        fi
    done
    return "$rc"
}

# Everything restored in step 1 (certificates, sites) is read back from the file system.
ezb_verify_step1() { # ezb_verify_step1 <backup dir>
    local d="$1" name f
    if [[ -d "$d/certs" ]]; then
        ezb_same_tree "$d/certs" "$CERT_DIR" || return 1
        for f in "$d/certs"/*/privkey.pem; do
            [[ -f "$f" ]] || continue
            [[ "$(stat -c %a -- "$CERT_DIR/${f#"$d"/certs/}" 2>/dev/null)" == "600" ]] || return 1
        done
    fi
    for name in "${EZB_A_SITES[@]}"; do
        cmp -s -- "$d/nginx-sites/$name" "$NGX_CONFD/$name" || return 1
    done
    return 0
}

# Put certificates and sites back as the pre-restore backup had them.
ezb_rollback_step1() { # ezb_rollback_step1 <pre-restore backup>
    local pre="$1" names=() e ok=1
    ezb_undo_new
    for e in "$pre/nginx-sites"/*.conf; do [[ -f "$e" ]] && names+=("${e##*/}"); done
    ezb_apply_certs "$pre" || ok=0
    ezb_apply_sites "$pre" "${names[@]}" || ok=0
    EZB_NEW=()
    ezb_verify_step1_after_rollback "$pre" || ok=0
    ((ok == 1))
}
ezb_verify_step1_after_rollback() {
    local e
    [[ -d "$1/certs" ]] && { ezb_same_tree "$1/certs" "$CERT_DIR" || return 1; }
    for e in "$1/nginx-sites"/*.conf; do
        [[ -f "$e" ]] || continue
        cmp -s -- "$e" "$NGX_CONFD/${e##*/}" || return 1
    done
    return 0
}

ezb_restore_cmd() {
    local pick sel reply pre name nsites=0 do_sites=0 step1_ok=1 f failed=0 certs_n=0
    local restored=() notes=()
    ezb_preflight "Restore backup" write || return 0
    ezb_load_list
    info ""
    if ((${#EZB_L_DIRS[@]} == 0)); then
        info "No ezvps backups found in ${EZB_BACKUP_BASE}. Nothing to restore."
        return 0
    fi
    ezb_print_list
    info ""
    if ! read -r -p "Number of the backup to restore (empty to cancel): " pick; then
        info ""
        return 0
    fi
    pick="${pick//[[:space:]]/}"
    [[ -z "$pick" ]] && {
        info "Cancelled. Nothing was changed."
        return 0
    }
    if [[ ! "$pick" =~ ^[0-9]{1,4}$ ]] || ((10#$pick < 1 || 10#$pick > ${#EZB_L_DIRS[@]})); then
        err "That is not one of the listed backups. Nothing was changed."
        return 0
    fi
    sel="${EZB_L_DIRS[$((10#$pick - 1))]}"
    ezb_validate_backup "$sel" || {
        err "Nothing was changed."
        return 0
    }
    info ""
    info "Selected: ${sel}"
    info "A restore will put back:"
    ((EZB_V_SCRIPT == 1)) && info "  the ezvps script           -> ${EZB_BIN}"
    ((${#EZB_V_STATE[@]} > 0)) && info "  ezvps state files          -> ${EZB_STATE_DIR}: ${EZB_V_STATE[*]}"
    ((${#EZB_V_CERTS[@]} > 0)) && info "  certificates (with keys)   -> ${CERT_DIR}: ${EZB_V_CERTS[*]}"
    ((${#EZB_V_SITES[@]} > 0)) && info "  ezvps-made nginx sites     -> ${NGX_CONFD}: ${EZB_V_SITES[*]}"
    if ((EZB_V_SCRIPT == 0 && ${#EZB_V_STATE[@]} == 0 && ${#EZB_V_CERTS[@]} == 0 && ${#EZB_V_SITES[@]} == 0)); then
        info "  nothing: this backup is empty."
        info "Nothing was changed."
        return 0
    fi
    info "Files with the same name are overwritten; files that are not in the backup are left as they are."
    info "The current state is backed up first. If an nginx config test fails after the sites are"
    info "restored, the certificates and sites are put back as they were and nginx is not reloaded."
    if ! IFS= read -r -p "Type YES to restore this backup: " reply; then
        info ""
        info "Nothing was changed."
        return 0
    fi
    if [[ "$reply" != "YES" ]]; then
        info "Cancelled (only the exact word YES confirms). Nothing was changed."
        return 0
    fi

    info ""
    info "Backing up the current state first..."
    ezb_create pre-restore full || {
        err "Restore cancelled: the current state could not be backed up. Nothing was changed."
        return 0
    }
    pre="$EZB_LAST_PATH"

    # Sites need nginx: its config dir and the nginx command (for the config test).
    nsites=${#EZB_V_SITES[@]}
    if ((nsites > 0)); then
        if [[ -d "$NGX_CONFD" ]] && have_cmd nginx; then
            do_sites=1
        else
            warn "nginx (or ${NGX_CONFD}) is not present, so the nginx sites in this backup are NOT restored."
            notes+=("nginx sites: not restored (nginx or ${NGX_CONFD} is missing)")
        fi
    fi

    # Step 1: certificates, then sites, then the nginx config test.
    EZB_NEW=()
    EZB_A_SITES=() EZB_A_SKIPPED=()
    ezb_apply_certs "$sel" || step1_ok=0
    certs_n=$EZB_A_CERT_FILES
    if ((do_sites == 1)); then
        ezb_apply_sites "$sel" "${EZB_V_SITES[@]}" || step1_ok=0
    fi
    ezb_verify_step1 "$sel" || step1_ok=0
    if ((step1_ok == 1 && ${#EZB_A_SITES[@]} > 0)); then
        if ngx_config_test; then
            info "nginx -t passed after restoring the sites."
        else
            step1_ok=0
            err "nginx -t FAILED after restoring the sites:"
            ngx_print_test_output
        fi
    fi
    if ((step1_ok == 0)); then
        err "Rolling back the certificates and sites restored in this run..."
        if ezb_rollback_step1 "$pre"; then
            info "Rolled back: certificates and sites are as they were (verified against ${pre})."
            if ((do_sites == 1)); then
                if ngx_config_test; then info "nginx -t passes again."; else
                    err "nginx -t still fails; this was already so, or check it by hand:"
                    ngx_print_test_output
                fi
            fi
        else
            err "The rollback could not be verified. The state before the restore is in ${pre}."
        fi
        err "Restore failed. nginx was not reloaded; the script and state files were not changed."
        return 0
    fi
    if ((${#EZB_A_SITES[@]} > 0)); then
        ngx_reload
    elif ((certs_n > 0)); then
        notes+=("certificates were restored; nginx was not reloaded (use Nginx > Restart if a site uses them)")
    fi
    ((certs_n > 0)) && restored+=("certificates: $(ezb_plural "$certs_n" file) in ${CERT_DIR} (verified, keys mode 600)")
    ((${#EZB_A_SITES[@]} > 0)) && restored+=("nginx sites: ${EZB_A_SITES[*]} (nginx -t passed)")
    ((${#EZB_A_SKIPPED[@]} > 0)) && notes+=("nginx sites not overwritten (not made by ezvps): ${EZB_A_SKIPPED[*]}")

    # Step 2: state files, then the script.
    if ((${#EZB_V_STATE[@]} > 0)); then
        if [[ ! -d "$EZB_STATE_DIR" ]]; then mkdir -p -- "$EZB_STATE_DIR" && chmod 700 -- "$EZB_STATE_DIR"; fi
        for name in "${EZB_V_STATE[@]}"; do
            if ezb_put_file "$sel/state/$name" "$EZB_STATE_DIR/$name" && cmp -s -- "$sel/state/$name" "$EZB_STATE_DIR/$name"; then
                :
            else
                err "Could not restore ${EZB_STATE_DIR}/${name}."
                failed=1
            fi
        done
        ((failed == 0)) && restored+=("state files: ${EZB_V_STATE[*]} in ${EZB_STATE_DIR} (verified)")
    fi
    if ((EZB_V_SCRIPT == 1)); then
        if ezb_install_script "$sel/bin/ezvps" && cmp -s -- "$sel/bin/ezvps" "$EZB_BIN" && upd_verify_script "$EZB_BIN"; then
            restored+=("ezvps script: ${EZB_BIN} (version ${UPD_VERIFY_VERSION}, verified)")
        else
            err "The restored ezvps script did not verify; putting the previous one back."
            if [[ -f "$pre/bin/ezvps" ]] && ezb_install_script "$pre/bin/ezvps" && cmp -s -- "$pre/bin/ezvps" "$EZB_BIN"; then
                info "The previous ezvps script is back (verified)."
            else
                err "Could not put the previous script back. It is in ${pre}/bin/ezvps."
            fi
            failed=1
        fi
    fi
    info ""
    if ((failed == 1)); then
        err "The restore finished with problems (see above). The state before it is in ${pre}."
    else
        info "Restored from ${sel}:"
    fi
    for f in "${restored[@]}"; do info "  restored: ${f}"; done
    for f in "${notes[@]}"; do info "  note:     ${f}"; done
    info "Nothing that is not in the backup was deleted. The state before the restore is in ${pre}."
    return 0
}

ezb_backup_menu() {
    local choice i labels=("Create backup" "List backups" "Restore backup")
    while true; do
        info ""
        info "${C_BOLD}Backup${C_RESET}"
        info ""
        for i in "${!labels[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${labels[$i]}"
        done
        printf '%2d) %s\n' 0 "Back"
        info ""
        if ! read -r -p "Select: " choice; then
            info ""
            return 0
        fi
        choice="${choice//[[:space:]]/}"
        case "$choice" in
            0) return 0 ;;
            1) ezb_create_cmd || true ;;
            2) ezb_list_cmd || true ;;
            3) ezb_restore_cmd || true ;;
            *) warn "Invalid choice: ${choice:-<empty>}" ;;
        esac
        pause "Press Enter to continue... " || true
    done
}

module_backup() { ezb_backup_menu; }

# --- check for updates / update ----------------------------------------------

# The update source is the git remote the checkout was cloned from (recorded by
# install.sh), so nothing private is hardcoded and nothing is downloaded anonymously:
# git uses the user's own authentication. Accepted: https://host/path (no credentials in
# the address), ssh://[user@]host/path and user@host:path. Never http, git, file or a path.
upd_valid_source() {
    local u="$1"
    ((${#u} <= 300)) || return 1
    [[ "$u" =~ ^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?/[A-Za-z0-9._~+-]+(/[A-Za-z0-9._~+-]+)*$ ]] && return 0
    [[ "$u" =~ ^ssh://([A-Za-z0-9_][A-Za-z0-9._-]*@)?[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?/[A-Za-z0-9._~+-]+(/[A-Za-z0-9._~+-]+)*$ ]] && return 0
    [[ "$u" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9.-]*:[A-Za-z0-9._~+-]+(/[A-Za-z0-9._~+-]+)*$ ]] && return 0
    return 1
}

upd_resolve_source() {
    local u
    if upd_valid_source "$UPD_SOURCE"; then
        return 0
    fi
    if [[ -n "$UPD_SOURCE" ]]; then
        warn "The repository address recorded at install time is not an accepted one; it is ignored."
    else
        info "ezvps does not know which repository it was installed from (no install record)."
    fi
    info "Enter the address of the private ezvps repository, the same one you cloned to run install.sh:"
    info "  git@github.com:<owner>/ezvps.git   or   https://github.com/<owner>/ezvps.git"
    info "Do not put a token or password in it; git asks for credentials itself."
    if ! read -r -p "Repository (empty to cancel): " u; then
        info ""
        return 1
    fi
    u="${u//[[:space:]]/}"
    if [[ -z "$u" ]]; then
        info "Cancelled. Nothing was changed."
        return 1
    fi
    if ! upd_valid_source "$u"; then
        err "That is not an accepted repository address (https://host/owner/repo, ssh://host/owner/repo or user@host:owner/repo, with no credentials in it). Nothing was changed."
        return 1
    fi
    UPD_SOURCE="$u"
    return 0
}

upd_cleanup() {
    [[ -n "$UPD_TMP" && -d "$UPD_TMP" ]] && rm -rf -- "$UPD_TMP"
    UPD_TMP=""
    return 0
}

# The only git network access outside the ctunnel fetch: a shallow clone of main, over
# https or ssh only, with the user's own authentication (git's credential helpers, an ssh
# key, or a prompt on the terminal). No anonymous URL, no curl, no wget.
upd_fetch_latest() { # upd_fetch_latest <dir>
    local g=(git -c protocol.allow=never -c protocol.https.allow=always -c protocol.ssh.allow=always)
    "${g[@]}" clone -q --depth 1 --branch "$EZB_UPDATE_BRANCH" --single-branch -- "$UPD_SOURCE" "$1"
}

# upd_get_latest: UPD_TMP/src is a checkout of the latest main; sets UPD_LATEST_COMMIT and
# UPD_LATEST_VERSION. The caller runs upd_cleanup.
upd_get_latest() {
    local c
    UPD_LATEST_COMMIT="" UPD_LATEST_VERSION=""
    if ! have_cmd git; then
        err "git is not installed. It is needed to fetch the latest ezvps from the private repository"
        err "(ezvps never uses an anonymous URL for it). Install it with: apt-get install git"
        return 1
    fi
    if ! UPD_TMP="$(mktemp -d)"; then
        err "Cannot create a temporary directory."
        return 1
    fi
    info "Fetching the latest '${EZB_UPDATE_BRANCH}' from ${UPD_SOURCE} with git."
    info "git uses your own authentication (a GitHub CLI login, an SSH key, or a token typed at git's prompt)."
    if ! upd_fetch_latest "${UPD_TMP}/src"; then
        err "Could not fetch '${EZB_UPDATE_BRANCH}' from ${UPD_SOURCE}. Check the address and that you have access to the repository. Nothing was changed."
        upd_cleanup
        return 1
    fi
    c="$(git -C "${UPD_TMP}/src" rev-parse HEAD 2>/dev/null)"
    if [[ ! "$c" =~ ^[0-9a-f]{40}$ ]] || [[ ! -f "${UPD_TMP}/src/ezvps" ]]; then
        err "The fetched '${EZB_UPDATE_BRANCH}' is not an ezvps checkout (no commit or no ezvps script). Nothing was changed."
        upd_cleanup
        return 1
    fi
    UPD_LATEST_COMMIT="$c"
    UPD_LATEST_VERSION="$(upd_file_version "${UPD_TMP}/src/ezvps")"
    return 0
}

# Installed versus latest: up to date, update available, or unknown (never "up to date" by default).
upd_compare() {
    local iv="${UPD_INST_VERSION:-unknown}" lv="${UPD_LATEST_VERSION:-unknown}"
    info ""
    if [[ -n "$UPD_INST_COMMIT" ]]; then
        info "Installed:  version ${iv}, commit ${UPD_INST_COMMIT:0:12}"
    else
        info "Installed:  version ${iv}, commit unknown"
        info "            (${UPD_INST_WHY})"
    fi
    info "Latest:     version ${lv}, commit ${UPD_LATEST_COMMIT:0:12} (${EZB_UPDATE_BRANCH} of ${UPD_SOURCE})"
    info ""
    if [[ -z "$UPD_INST_COMMIT" ]]; then
        warn "Unknown: ezvps cannot tell whether this install is up to date, so it is NOT reported as current."
        [[ "$iv" != "$lv" ]] && info "The versions differ (${iv} installed, ${lv} latest)."
        info "Use 'Update ezvps' to install the latest ${EZB_UPDATE_BRANCH}; that also records the version and commit."
    elif [[ "$UPD_INST_COMMIT" == "$UPD_LATEST_COMMIT" ]]; then
        info "Up to date: the installed commit is the latest ${EZB_UPDATE_BRANCH}."
    else
        info "Update available: the latest ${EZB_UPDATE_BRANCH} is a different commit than the installed one."
        info "Use 'Update ezvps' to install it."
    fi
    return 0
}

upd_check_cmd() {
    ezb_preflight "Check for updates" read || return 0
    require_cmds sha256sum || return 0
    upd_installed_info
    upd_resolve_source || return 0
    upd_get_latest || return 0
    upd_compare
    upd_cleanup
    info "Nothing was changed."
    return 0
}

# upd_verify_script <file>: bash -n, then --version must print "ezvps <version>".
upd_verify_script() {
    local out
    UPD_VERIFY_VERSION="" UPD_VERIFY_OUT=""
    if ! out="$(bash -n "$1" 2>&1)"; then
        UPD_VERIFY_OUT="syntax check failed: ${out%%$'\n'*}"
        return 1
    fi
    if ! out="$(EZVPS_ALLOW_NONROOT=1 bash "$1" --version </dev/null 2>&1)"; then
        UPD_VERIFY_OUT="--version failed: ${out%%$'\n'*}"
        return 1
    fi
    if [[ ! "$out" =~ ^ezvps\ ([A-Za-z0-9._+-]+)$ ]]; then
        UPD_VERIFY_OUT="--version did not report a version"
        return 1
    fi
    UPD_VERIFY_VERSION="${BASH_REMATCH[1]}"
    return 0
}

# ezb_install_script <src>: temp file next to the target, mode 755, atomic mv.
ezb_install_script() {
    local tmp dir="${EZB_BIN%/*}"
    mkdir -p -- "$dir" || return 1
    tmp="$(mktemp "${dir}/.ezvps.XXXXXX")" || return 1
    if cp -- "$1" "$tmp" && chmod 0755 -- "$tmp" && mv -f -- "$tmp" "$EZB_BIN"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# upd_state_write <version> <commit> <source>: records what is installed now (never a secret).
upd_state_write() {
    local sha tmp
    sha="$(sha256sum "$EZB_BIN" 2>/dev/null)"
    sha="${sha%% *}"
    { mkdir -p -- "$EZB_STATE_DIR" && chmod 700 -- "$EZB_STATE_DIR"; } 2>/dev/null || return 1
    tmp="${EZB_INSTALL_STATE}.tmp.$$"
    {
        printf 'version=%s\n' "$1"
        printf 'commit=%s\n' "$2"
        printf 'source=%s\n' "$3"
        printf 'sha256=%s\n' "$sha"
        printf 'installed=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$tmp" 2>/dev/null || {
        rm -f -- "$tmp"
        return 1
    }
    if ! chmod 600 -- "$tmp" || ! mv -f -- "$tmp" "$EZB_INSTALL_STATE"; then
        rm -f -- "$tmp"
        return 1
    fi
    [[ "$(upd_state_get commit)" == "$2" && "$(upd_state_get sha256)" == "$sha" ]]
}

# Every state file except install.state is byte-for-byte what the backup holds.
ezb_state_unchanged() { # ezb_state_unchanged <backup dir>
    local e
    for e in "$1/state"/*; do
        [[ -f "$e" ]] || continue
        [[ "${e##*/}" == "install.state" ]] && continue
        cmp -s -- "$e" "$EZB_STATE_DIR/${e##*/}" || return 1
    done
    return 0
}

upd_update_cmd() {
    local cand bak old_v new_v
    ezb_preflight "Update ezvps" write || return 0
    require_cmds sha256sum bash || return 0
    if [[ ! -f "$EZB_BIN" ]]; then
        err "ezvps is not installed at ${EZB_BIN}; nothing to update. Run install.sh from a checkout of the repository. Nothing was changed."
        return 0
    fi
    upd_installed_info
    upd_resolve_source || return 0
    upd_get_latest || return 0
    upd_compare
    cand="${UPD_TMP}/src/ezvps"
    old_v="${UPD_INST_VERSION:-unknown}"

    # The candidate is checked before anything is touched.
    if ! upd_verify_script "$cand"; then
        err "The latest ${EZB_UPDATE_BRANCH} script is not usable (${UPD_VERIFY_OUT}). Nothing was changed."
        upd_cleanup
        return 0
    fi
    new_v="$UPD_VERIFY_VERSION"
    if cmp -s -- "$cand" "$EZB_BIN"; then
        info "The installed script is byte-for-byte the latest ${EZB_UPDATE_BRANCH}; there is nothing to replace."
        if [[ "$UPD_INST_COMMIT" == "$UPD_LATEST_COMMIT" ]]; then
            info "The install record already matches."
        elif upd_state_write "$new_v" "$UPD_LATEST_COMMIT" "$UPD_SOURCE"; then
            info "Recorded version ${new_v} and commit ${UPD_LATEST_COMMIT:0:12} in ${EZB_INSTALL_STATE} (verified)."
        else
            warn "Could not write ${EZB_INSTALL_STATE}; the commit stays unknown."
        fi
        upd_cleanup
        return 0
    fi
    info ""
    info "ezvps will replace ${EZB_BIN}: version ${old_v} -> ${new_v} (commit ${UPD_LATEST_COMMIT:0:12})."
    info "The current script and the ezvps state files are backed up first. Tool configs, nginx sites,"
    info "certificates, users and all other state are not touched."
    if ! ask_yes_no "Update ezvps now?"; then
        info "Nothing was changed."
        upd_cleanup
        return 0
    fi
    ezb_create pre-update core || {
        err "Update cancelled: the current ezvps could not be backed up. Nothing was changed."
        upd_cleanup
        return 0
    }
    bak="$EZB_LAST_PATH"
    if ! ezb_install_script "$cand" || ! cmp -s -- "$cand" "$EZB_BIN" || ! upd_verify_script "$EZB_BIN"; then
        err "The new script did not verify after it was installed${UPD_VERIFY_OUT:+ (${UPD_VERIFY_OUT})}. Rolling back..."
        if [[ -f "$bak/bin/ezvps" ]] && ezb_install_script "$bak/bin/ezvps" && cmp -s -- "$bak/bin/ezvps" "$EZB_BIN"; then
            info "Rolled back: ${EZB_BIN} is the previous script again (verified byte for byte against ${bak})."
        else
            err "The rollback could not be verified. The previous script is in ${bak}/bin/ezvps; copy it to ${EZB_BIN}."
        fi
        upd_cleanup
        return 0
    fi
    if ! upd_state_write "$new_v" "$UPD_LATEST_COMMIT" "$UPD_SOURCE"; then
        warn "ezvps was updated but ${EZB_INSTALL_STATE} could not be written; its commit stays unknown."
    fi
    info ""
    info "Updated ${EZB_BIN}: version ${old_v} -> ${UPD_VERIFY_VERSION}, commit ${UPD_LATEST_COMMIT:0:12}."
    info "Verified: the installed file is byte-for-byte the fetched ${EZB_UPDATE_BRANCH}, passes bash -n and reports 'ezvps ${UPD_VERIFY_VERSION}'."
    if ezb_state_unchanged "$bak"; then
        info "Verified: the other ezvps state files are unchanged. Tool configs, sites, certificates and users were not touched."
    else
        warn "A state file differs from the backup; compare ${bak}/state with ${EZB_STATE_DIR}."
    fi
    info "Previous version backed up at ${bak}. Restart ezvps to use the new version."
    upd_cleanup
    return 0
}

upd_menu() {
    local choice i labels=("Check for updates" "Update ezvps")
    while true; do
        info ""
        info "${C_BOLD}Check For Updates${C_RESET}"
        info ""
        for i in "${!labels[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${labels[$i]}"
        done
        printf '%2d) %s\n' 0 "Back"
        info ""
        if ! read -r -p "Select: " choice; then
            info ""
            return 0
        fi
        choice="${choice//[[:space:]]/}"
        case "$choice" in
            0) return 0 ;;
            1) upd_check_cmd || true ;;
            2) upd_update_cmd || true ;;
            *) warn "Invalid choice: ${choice:-<empty>}" ;;
        esac
        pause "Press Enter to continue... " || true
    done
}

module_update() { upd_menu; }

# --- uninstall ---------------------------------------------------------------

module_uninstall() {
    local e reply bak p state_files=() removed=() left_over=() kept=() tool
    ezb_preflight "Uninstall" write || return 0
    for e in "$EZB_STATE_DIR"/*.state "$EZB_STATE_DIR"/*.state.tmp.*; do
        [[ -f "$e" || -L "$e" ]] && state_files+=("$e")
    done
    if [[ ! -e "$EZB_BIN" && ! -L "$EZB_BIN" ]] && ((${#state_files[@]} == 0)); then
        info ""
        info "ezvps is not installed (no ${EZB_BIN}, no state files in ${EZB_STATE_DIR}); there is nothing to uninstall."
        return 0
    fi
    info ""
    info "Uninstall removes ezvps itself, and only that:"
    [[ -e "$EZB_BIN" || -L "$EZB_BIN" ]] && info "  ${EZB_BIN}"
    for e in "${state_files[@]}"; do info "  ${e}"; done
    info "It does NOT touch nginx, 3x-ui, Backpack, ctunnel, Lazyports, ezl2tp, their configs, nginx sites,"
    info "certificates, users, SSH settings, or any backup (backups are never deleted)."
    info "Your current ezvps script and state files are backed up first."
    if ! IFS= read -r -p "Type YES to uninstall ezvps: " reply; then
        info ""
        info "Nothing was changed."
        return 0
    fi
    if [[ "$reply" != "YES" ]]; then
        info "Cancelled (only the exact word YES confirms). Nothing was changed."
        return 0
    fi
    info ""
    ezb_create pre-uninstall core || {
        err "Uninstall cancelled: the backup could not be made. Nothing was changed."
        return 0
    }
    bak="$EZB_LAST_PATH"
    info "Backup path: ${bak}"
    if [[ -f "$EZB_BIN" && ! -f "$bak/bin/ezvps" ]]; then
        err "The backup does not contain the ezvps script; not removing anything."
        return 0
    fi
    for e in "$EZB_BIN" "${state_files[@]}"; do
        [[ -e "$e" || -L "$e" ]] || continue
        rm -f -- "$e" 2>/dev/null
        if [[ -e "$e" || -L "$e" ]]; then
            left_over+=("$e")
        else
            removed+=("$e")
        fi
    done
    rmdir -- "$EZB_STATE_DIR" 2>/dev/null
    info ""
    info "Removed (checked on the file system):"
    if ((${#removed[@]} == 0)); then info "  nothing"; fi
    for e in "${removed[@]}"; do info "  ${e}"; done
    if ((${#left_over[@]} > 0)); then
        err "These could NOT be removed:"
        for e in "${left_over[@]}"; do err "  ${e}"; done
    fi
    [[ -d "$EZB_STATE_DIR" ]] && info "The state directory ${EZB_STATE_DIR} is kept because it still holds other files."
    info ""
    info "Left untouched (looked up on the file system just now):"
    kept=("$NGX_DIR" "$XUI_DIR" "$XUI_DB_DIR" "$CERT_DIR" "$ACME_HOME" "$LC_BACKPACK_CONF" "$EZB_BACKUP_BASE")
    for tool in backpack ctunnel lazyports; do kept+=("${LC_PREFIX}/bin/${tool}"); done
    for p in "${kept[@]}"; do
        if [[ -e "$p" ]]; then info "  ${p} (present, not touched)"; else info "  ${p} (not present)"; fi
    done
    info "  user accounts, SSH settings and firewall rules (never touched by ezvps Uninstall)"
    info "  ${EZB_BACKUP_BASE}: all backups kept, including ${bak}"
    if [[ ! -e "$EZB_BIN" && ! -L "$EZB_BIN" ]]; then
        info ""
        info "ezvps is uninstalled. To bring it back: run install.sh from the repository checkout,"
        info "or copy ${bak}/bin/ezvps to ${EZB_BIN}."
        EZB_UNINSTALLED=1
    fi
    return 0
}

# Dispatch a module by key. Always returns 0 so a module can never take the
# menu down; real failures are reported by the module itself.
run_module() {
    case "$1" in
        l2tp) module_l2tp ;;
        3x-ui) module_3x_ui ;;
        nginx) module_nginx ;;
        certs) module_certs ;;
        backpack) module_backpack ;;
        ctunnel) module_ctunnel ;;
        lazyports) module_lazyports ;;
        ssh) module_ssh ;;
        firewall) module_firewall ;;
        backup) module_backup ;;
        update) module_update ;;
        uninstall) module_uninstall ;;
        *)
            err "Unknown module: $1"
            return 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Menu
# ---------------------------------------------------------------------------

print_menu() {
    local i
    info "${C_BOLD}ezvps ${EZVPS_VERSION}${C_RESET}"
    info ""
    for i in "${!MODULE_LABELS[@]}"; do
        printf '%2d) %s\n' "$((i + 1))" "${MODULE_LABELS[$i]}"
    done
    printf '%2d) %s\n' 0 "Exit"
    info ""
}

main_menu() {
    local choice
    while true; do
        clear_screen
        print_menu
        if ! read -r -p "Select: " choice; then
            info ""
            return 0 # EOF on stdin: leave cleanly
        fi
        choice="${choice//[[:space:]]/}"
        if [[ "$choice" == "0" ]]; then
            return 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && ((10#$choice >= 1 && 10#$choice <= ${#MODULE_KEYS[@]})); then
            run_module "${MODULE_KEYS[$((10#$choice - 1))]}"
            pause || true
            if ((EZB_UNINSTALLED == 1)); then
                info "ezvps has been uninstalled; leaving the menu."
                return 0
            fi
        else
            warn "Invalid choice: ${choice:-<empty>}"
            pause || true
        fi
    done
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

usage() {
    info "ezvps ${EZVPS_VERSION} - VPS manager for Debian 12/13 and Ubuntu 22.04/24.04/26.04 LTS

Usage:
  ezvps                 open the interactive menu
  ezvps <module>        run one module directly
  ezvps --version       print the version
  ezvps --help          show this help

Modules:
  l2tp 3x-ui backpack ctunnel nginx certs lazyports ssh firewall
  backup update uninstall

All of these modules are implemented in this release."
}

require_root() {
    if ((EUID != 0)) && [[ "${EZVPS_ALLOW_NONROOT:-0}" != "1" ]]; then
        err "ezvps must be run as root."
        return 1
    fi
    return 0
}

main() {
    case "${1:-}" in
        -h | --help | help)
            usage
            return 0
            ;;
        -V | --version | version)
            info "ezvps ${EZVPS_VERSION}"
            return 0
            ;;
        "" | menu)
            require_root || return 1
            main_menu
            return $?
            ;;
        *)
            local key="$1" known=0 k
            for k in "${MODULE_KEYS[@]}"; do
                [[ "$k" == "$key" ]] && known=1
            done
            if ((known == 0)); then
                err "Unknown command: $key"
                usage >&2
                return 2
            fi
            require_root || return 1
            run_module "$key"
            return $?
            ;;
    esac
}

main "$@"
